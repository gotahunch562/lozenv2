---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
import FounderPortrait from '../components/FounderPortrait.astro';

const eventbriteUrl = "https://www.eventbrite.com/e/when-ai-carries-your-name-a-briefing-for-leaders-using-ai-at-work-tickets-1992815940122?l";
---

<BaseLayout
  title="When AI Carries Your Name: Leadership Webinar | Lozen Advisory"
  description="A practical webinar for leaders on human accountability for AI-assisted decisions, documents, reports, approvals, professional judgment, and oversight."
>
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap web-hero">
    <div class="inner" style="max-width:none">
      <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Webinar</div>
      <span class="pill"><span style="width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block"></span> ONLINE WEBINAR · THURSDAYS</span>
      <h1>When AI Carries Your Name: <span class="hl">A Briefing for Leaders Using AI at Work</span></h1>
      <p class="sub">A practical briefing for leaders using AI at work who need to understand when faster output becomes a judgment, approval, or reputation risk.</p>
      <div class="web-meta">
        <span class="chip">📅 Thursdays</span>
        <span class="chip">🕘 11:00 AM–12:00 PM ET</span>
        <span class="chip">💻 Online event</span>
        <span class="chip">Hosted by Lozen Advisory LLC</span>
      </div>
      <p style="color:rgba(255,255,255,.6);font-size:13.5px;font-weight:600;margin-top:18px">Next session starts in</p>
      <div class="countdown" id="countdown">
        <div class="cd"><div class="v" id="cd-d">0</div><div class="u">Days</div></div>
        <div class="cd"><div class="v" id="cd-h">0</div><div class="u">Hours</div></div>
        <div class="cd"><div class="v" id="cd-m">0</div><div class="u">Mins</div></div>
        <div class="cd"><div class="v" id="cd-s">0</div><div class="u">Secs</div></div>
      </div>
    </div>

    <!-- REGISTRATION CARD -->
    <div id="register" class="reg-card">
      <span class="seats">Executive AI governance webinar</span>
      <h3 style="font-size:23px;font-weight:700;margin-bottom:4px">Attend the webinar</h3>
      <p class="sub" style="color:var(--muted);font-size:14.5px;margin-bottom:20px">Register through Eventbrite to receive the online event link and calendar details.</p>

      <div class="field">
        <label>Designed for</label>
        <p>Business leaders, executives, senior managers, general counsel, compliance leaders, risk leaders, consultants, and board-adjacent professionals.</p>
      </div>

      <div class="field">
        <label>Session focus</label>
        <p>Human accountability for AI-assisted decisions, documents, reports, advice, approvals, and oversight.</p>
      </div>

      <a href={eventbriteUrl} class="btn btn-accent">Register on Eventbrite →</a>
      <p style="font-size:12px;color:var(--muted);text-align:center;margin-top:12px">Registration and event access are managed through Eventbrite.</p>
    </div>
  </div>
</section>

<!-- WHAT YOU'LL LEARN -->
<section>
  <div class="wrap">
    <div class="center section-head">
      <span class="eyebrow">What you'll learn</span>
      <h2 class="h2">What must be true before AI-assisted work carries your name</h2>
    </div>

    <div class="feature-grid">
      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
        <h3>Where your name is already attached</h3>
        <p>Identify where AI-assisted work may already be touching your approval, professional judgment, or reputation.</p>
      </div>

      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
        <h3>When human review is not enough</h3>
        <p>Understand why “human in the loop” language can still leave accountability unresolved.</p>
      </div>

      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
        <h3>What must be verified</h3>
        <p>Examine what must be checked before AI-assisted work is approved, shared, submitted, or relied upon.</p>
      </div>

      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
        <h3>Why software cannot own judgment</h3>
        <p>See why technical controls and software tools cannot replace human accountability.</p>
      </div>

      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div>
        <h3>The five accountability conditions</h3>
        <p>Evaluate time, review capacity and tools, information access, documentation infrastructure, and formal refusal rights.</p>
      </div>

      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <h3>The Name Standard℠</h3>
        <p>Use Lozen Advisory’s framework to identify accountability gaps before they become visible failures.</p>
      </div>
    </div>
  </div>
</section>

<!-- AGENDA -->
<section class="band">
  <div class="wrap">
    <div class="center section-head">
      <span class="eyebrow">Agenda</span>
      <h2 class="h2">How the hour runs</h2>
    </div>

    <div class="agenda" style="margin-left:auto;margin-right:auto">
      <div class="ag reveal"><div class="t">0:00</div><div><h4>Where AI is touching human judgment</h4><p>How ordinary AI-assisted work becomes an approval, reputation, and accountability issue.</p></div></div>
      <div class="ag reveal"><div class="t">0:15</div><div><h4>When oversight becomes ceremonial</h4><p>Why a named human reviewer does not automatically create meaningful accountability.</p></div></div>
      <div class="ag reveal"><div class="t">0:30</div><div><h4>The five conditions of the Name Standard℠</h4><p>Time, review capacity and tools, information access, documentation infrastructure, and refusal rights.</p></div></div>
      <div class="ag reveal"><div class="t">0:50</div><div><h4>Applying the standard at work</h4><p>What leaders should verify before approving, sharing, submitting, or relying on AI-assisted work.</p></div></div>
    </div>
  </div>
</section>

<!-- HOST -->
<section>
  <div class="wrap" style="max-width:820px">
    <div class="center section-head">
      <span class="eyebrow">Your host</span>
      <h2 class="h2">Hosted by Lozen Advisory</h2>
    </div>

    <div class="host reveal">
      <FounderPortrait variant="host" alt="Akilah E. Kamaria" />
      <div>
        <div class="nm">Akilah E. Kamaria</div>
        <div class="rl">Founder, Lozen Advisory LLC</div>
        <p>Akilah E. Kamaria leads Lozen Advisory, a governance advisory firm providing strategic counsel for the era of algorithmic accountability.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<CtaStrip
  title="When AI-assisted work carries your name, what can you actually verify?"
  description="Attend the webinar to examine the conditions required for meaningful human accountability before AI-assisted work is approved, shared, submitted, or relied upon."
  primaryHref={eventbriteUrl}
  primaryLabel="Register on Eventbrite →"
  secondaryHref="/services/"
  secondaryLabel="Explore Advisory Services"
  paddedTop={true}
/>

</BaseLayout>
