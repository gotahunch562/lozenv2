---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us — Exporta Global" description="Get in touch — book a free consultation, call, or email our export consultants.">
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Contact</div>
    <span class="pill">We&apos;d love to hear from you</span>
    <h1>Let&apos;s talk about your export goals</h1>
    <p class="sub">Book a free consultation, send a message, or just ask a question. A trade expert will get back to you within 24 hours.</p>
    
  </div>
</section>

<section id="main">
  <div class="wrap">
    <div class="contact-grid">
      <div class="cinfo reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg></div><h3>Call us</h3><p><a href="tel:+10000000000">+1 (000) 000-0000</a><br>Mon–Fri, 9am–6pm</p></div>
      <div class="cinfo reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div><h3>Email us</h3><p><a href="mailto:hello@example.com">hello@example.com</a><br>We reply within 24 hours</p></div>
      <div class="cinfo reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div><h3>Visit us</h3><p>123 Trade Avenue<br>Your City, Country</p></div>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap cta-wrap">
    <div>
      <span class="eyebrow">Book a consultation</span>
      <h2 class="h2">Tell us about your business</h2>
      <p class="lead">Share a few details and we'll get back to you within one business day. There's no cost and no obligation — just a clear next step toward exporting.</p>
      <div class="contact-list">
        <a href="tel:+10000000000"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg></span> +1 (000) 000-0000</a>
        <a href="mailto:hello@example.com"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span> hello@example.com</a>
        <a href="#"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span> 123 Trade Avenue, Your City</a>
      </div>
    </div>
    <div>
      <form class="form" id="contactForm">
        <h3>Send us a message</h3>
        <p class="sub">Fill in your details — we'll reach out within 24 hours.</p>
        <div class="row2">
          <div class="field"><label>Your name</label><input type="text" required placeholder="Full name" /></div>
          <div class="field"><label>Phone</label><input type="tel" placeholder="Phone number" /></div>
        </div>
        <div class="row2">
          <div class="field"><label>Email</label><input type="email" required placeholder="you@email.com" /></div>
          <div class="field"><label>Company</label><input type="text" placeholder="Company name" /></div>
        </div>
        <div class="field"><label>I'm interested in</label>
          <select><option>Free consultation</option><option>Mentorship Program</option><option>SME Consultancy</option><option>Corporate Consultancy</option><option>A specific service</option><option>The free webinar</option></select>
        </div>
        <div class="field"><label>Message</label><textarea rows="3" placeholder="Tell us about your product and goals"></textarea></div>
        <button type="submit" class="btn btn-primary">Send message →</button>
      </form>
      <div class="form-success" id="contactSuccess"><div class="big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:52px;height:52px;color:var(--accent)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div><h3>Message sent!</h3><p>Thanks for reaching out. A trade expert will reply within 24 hours.</p></div>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap">
    <div class="map-ph reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      Map placeholder — embed Google Maps here
    </div>
  </div>
</section>
</BaseLayout>
