---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  'General inquiry',
  'Board AI Governance Advisory',
  'CFO Market Intelligence',
  'Algorithmic Accountability Risk',
  'Name Standard℠ Advisory',
  'AI Workforce Materiality Briefing',
];
---

<BaseLayout title="Contact Us | Lozen Advisory" description="Contact Lozen Advisory for board, CFO, legal, or risk-leadership advisory on AI governance, accountability, and workforce materiality.">
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Contact</div>
    <span class="pill">We&apos;d love to hear from you</span>
    <h1>Get in Touch</h1>
    <p class="sub">Have a question about AI governance, workforce materiality, or how Lozen Advisory can help your board or team? Send a message and we'll get back to you within one business day.</p>
  </div>
</section>

<section id="main">
  <div class="wrap">
    <div class="contact-grid">
      <div class="cinfo reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div><h3>Email us</h3><p><a href="mailto:hello@lozenadvisory.com">hello@lozenadvisory.com</a><br>We reply within one business day</p></div>
      <div class="cinfo reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div><h3>Mailing address</h3><p>Lozen Advisory LLC<br>8401 Mayland Dr # 7597<br>Richmond, VA 23294</p></div>
      <div class="cinfo reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div><h3>Prefer a formal briefing?</h3><p><a href="/request-briefing/">Request a Briefing →</a><br>For board, CFO, or risk-leadership scoping</p></div>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap cta-wrap">
    <div>
      <span class="eyebrow">Send a message</span>
      <h2 class="h2">Tell us how we can help</h2>
      <p class="lead">Share a few details and we'll get back to you within one business day. No obligation, and nothing shared outside this inquiry.</p>
      <div class="contact-list">
        <a href="mailto:hello@lozenadvisory.com"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span> hello@lozenadvisory.com</a>
        <a href="#"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span> Lozen Advisory LLC · Richmond, VA</a>
      </div>
    </div>
    <div>
      <form class="form" id="contactForm">
        <h3>Send us a message</h3>
        <p class="sub">Fill in your details — we'll reach out within one business day.</p>
        <div class="row2">
          <div class="field"><label>Your name</label><input type="text" required placeholder="Full name" /></div>
          <div class="field"><label>Title</label><input type="text" placeholder="e.g. General Counsel, CFO" /></div>
        </div>
        <div class="row2">
          <div class="field"><label>Email</label><input type="email" required placeholder="you@company.com" /></div>
          <div class="field"><label>Company</label><input type="text" placeholder="Company name" /></div>
        </div>
        <div class="field"><label>Reason for contact</label>
          <select>
            {services.map((service) => (<option>{service}</option>))}
          </select>
        </div>
        <div class="field"><label>Message</label><textarea rows="3" placeholder="How can we help?"></textarea></div>
        <button type="submit" class="btn btn-primary">Send message →</button>
      </form>
      <div class="form-success" id="contactSuccess"><div class="big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:52px;height:52px;color:var(--accent)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div><h3>Message sent!</h3><p>Thanks for reaching out. We'll reply within one business day.</p></div>
    </div>
  </div>
</section>
</BaseLayout>
