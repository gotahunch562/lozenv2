---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout title="Meridian Textiles — Case Study — Exporta Global" description="How an established manufacturer stood up a dedicated export division and doubled order volume.">
<section class="article-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb" style="margin-bottom:18px;color:rgba(255,255,255,.55)"><a href="/" style="color:rgba(255,255,255,.7)">Home</a> &nbsp;/&nbsp; <a href="/case-studies" style="color:rgba(255,255,255,.7)">Case Studies</a> &nbsp;/&nbsp; Meridian Textiles</div>
    <span class="tag">Textiles & Apparel</span>
    <h1>Building a corporate export wing from scratch</h1>
    <p class="sub" style="color:rgba(255,255,255,.74);font-size:18px;max-width:640px;margin:0 auto">How an established manufacturer stood up a dedicated export division and doubled order volume.</p>
  </div>
</section>

<section style="padding-bottom:0">
  <div class="wrap">
    <div class="cs-stats" style="justify-content:center;gap:48px;border:0;padding:0;text-align:center"><div class="s"><div class="v">12</div><div class="l">staff trained</div></div><div class="s"><div class="v">9</div><div class="l">export markets</div></div><div class="s"><div class="v">2x</div><div class="l">order volume</div></div></div>
  </div>
</section>

<section>
  <div class="wrap two-col">
    <div class="prose reveal">
      <span class="eyebrow">The challenge</span>
      <h2 class="h2">Where they started</h2>
      <p>Meridian was a successful domestic manufacturer that wanted exporting to become a core part of the business — not a side project. They needed a real export division: processes, trained people, and a pipeline of international buyers.</p>
    </div>
    <div class="reveal">
      <div class="checklist" style="grid-template-columns:1fr">
      <div class="check reveal"><span class="ck">✓</span><p>A fully operational export division</p></div><div class="check reveal"><span class="ck">✓</span><p>Twelve team members trained and self-sufficient</p></div><div class="check reveal"><span class="ck">✓</span><p>Active export pipelines across nine markets</p></div><div class="check reveal"><span class="ck">✓</span><p>Order volume doubled within the engagement</p></div>
      </div>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="center section-head"><span class="eyebrow">Our approach</span><h2 class="h2">How we helped</h2></div>
    <div class="steps">
      <div class="step reveal"><div class="num">1</div><h3>Operating model</h3><p>We designed the structure of an export wing — roles, workflows, and KPIs.</p></div><div class="step reveal"><div class="num">2</div><h3>Team training</h3><p>We trained twelve staff across sourcing, documentation, logistics, and payments.</p></div><div class="step reveal"><div class="num">3</div><h3>Market expansion</h3><p>We prioritized nine markets and built buyer pipelines for each.</p></div><div class="step reveal"><div class="num">4</div><h3>Systems & reporting</h3><p>We put executive reporting in place so leadership could track performance.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap" style="max-width:820px">
    <blockquote class="reveal" style="margin:0;padding:32px 36px;border-left:4px solid var(--accent);background:var(--paper-2);border-radius:0 16px 16px 0">
      <p style="font-size:21px;font-style:italic;color:#3c3a5e;line-height:1.6;margin:0 0 18px">"Setting up an export wing in our company was a game-changer with their consultancy. The whole process is finally clear."</p>
      <div style="display:flex;align-items:center;gap:12px">
        <div style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand-2));display:grid;place-items:center;color:#fff;font-weight:700">SA</div>
        <div><div style="font-weight:700">Sarah Adams</div><div style="font-size:13px;color:var(--muted)">Director, Meridian Textiles</div></div>
      </div>
    </blockquote>
  </div>
</section>

<CtaStrip
  title="Want results like Meridian Textiles?"
  description="We can help with corporate consultancy for your business too. Book a free consultation to find out how."
  primaryHref="/contact"
  primaryLabel="Get a Free Consultation →"
  secondaryHref="/consultancy"
  secondaryLabel="View consultancy options"
  paddedTop={false}
/>

<section class="band">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">More results</span><h2 class="h2">Related case studies</h2></div>
    <div class="cs-grid">
      <a href="/case-agrotrade" class="cs-card reveal">
      <div class="top"><div class="lg">AG</div><div><div class="ind">Agriculture / Food</div><div class="co">AgroTrade</div></div></div>
      <div class="body"><h3>From local supplier to 4-country exporter</h3><p>How a regional food producer with zero export experience reached four new markets in six months.</p></div>
    </a>
      <a href="/case-pioneer" class="cs-card reveal">
      <div class="top"><div class="lg">PW</div><div><div class="ind">Handicrafts</div><div class="co">Pioneer Works</div></div></div>
      <div class="body"><h3>Exporting without an in-house license</h3><p>How a small craft business started exporting — legally — without holding its own export license.</p></div>
    </a>
    </div>
  </div>
</section>
</BaseLayout>
