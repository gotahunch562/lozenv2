---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout title="Pioneer Works — Case Study — Exporta Global" description="How a small craft business started exporting — legally — without holding its own export license.">
<section class="article-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb" style="margin-bottom:18px;color:rgba(255,255,255,.55)"><a href="/" style="color:rgba(255,255,255,.7)">Home</a> &nbsp;/&nbsp; <a href="/case-studies" style="color:rgba(255,255,255,.7)">Case Studies</a> &nbsp;/&nbsp; Pioneer Works</div>
    <span class="tag">Handicrafts</span>
    <h1>Exporting without an in-house license</h1>
    <p class="sub" style="color:rgba(255,255,255,.74);font-size:18px;max-width:640px;margin:0 auto">How a small craft business started exporting — legally — without holding its own export license.</p>
  </div>
</section>

<section style="padding-bottom:0">
  <div class="wrap">
    <div class="cs-stats" style="justify-content:center;gap:48px;border:0;padding:0;text-align:center"><div class="s"><div class="v">3</div><div class="l">countries</div></div><div class="s"><div class="v">0</div><div class="l">license needed</div></div><div class="s"><div class="v">90d</div><div class="l">to first sale</div></div></div>
  </div>
</section>

<section>
  <div class="wrap two-col">
    <div class="prose reveal">
      <span class="eyebrow">The challenge</span>
      <h2 class="h2">Where they started</h2>
      <p>Pioneer Works made beautiful handicrafts but assumed exporting was out of reach — they didn't have an export license and couldn't justify the cost and process of obtaining one just to test demand.</p>
    </div>
    <div class="reveal">
      <div class="checklist" style="grid-template-columns:1fr">
      <div class="check reveal"><span class="ck">✓</span><p>Exporting to three countries without an in-house license</p></div><div class="check reveal"><span class="ck">✓</span><p>First international sale within 90 days</p></div><div class="check reveal"><span class="ck">✓</span><p>A low-cost, compliant model they can scale</p></div><div class="check reveal"><span class="ck">✓</span><p>Confidence to pursue their own license later, from a position of revenue</p></div>
      </div>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="center section-head"><span class="eyebrow">Our approach</span><h2 class="h2">How we helped</h2></div>
    <div class="steps">
      <div class="step reveal"><div class="num">1</div><h3>Route design</h3><p>We mapped a compliant license-free export route suited to their product and volume.</p></div><div class="step reveal"><div class="num">2</div><h3>Buyer matching</h3><p>We identified buyers in markets where their crafts had clear demand.</p></div><div class="step reveal"><div class="num">3</div><h3>Compliance</h3><p>We ensured every shipment met documentation and customs requirements.</p></div><div class="step reveal"><div class="num">4</div><h3>First sales</h3><p>We guided the first transactions and payment collection.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap" style="max-width:820px">
    <blockquote class="reveal" style="margin:0;padding:32px 36px;border-left:4px solid var(--accent);background:var(--paper-2);border-radius:0 16px 16px 0">
      <p style="font-size:21px;font-style:italic;color:#3c3a5e;line-height:1.6;margin:0 0 18px">"I didn't know you could export without your own license. Now I'm shipping regularly to three countries."</p>
      <div style="display:flex;align-items:center;gap:12px">
        <div style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand-2));display:grid;place-items:center;color:#fff;font-weight:700">TM</div>
        <div><div style="font-weight:700">Tom Mitchell</div><div style="font-size:13px;color:var(--muted)">Founder, Pioneer Works</div></div>
      </div>
    </blockquote>
  </div>
</section>

<CtaStrip
  title="Want results like Pioneer Works?"
  description="We can help with licensing and documentation for your business too. Book a free consultation to find out how."
  primaryHref="/contact"
  primaryLabel="Get a Free Consultation →"
  secondaryHref="/consultancy"
  secondaryLabel="View consultancy options"
  paddedTop={false}
/>

<section class="band">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">More results</span><h2 class="h2">Related case studies</h2></div>
    <div class="cs-grid">
      <a href="/case-agrotrade" class="cs-card reveal">
      <div class="top"><div class="lg">AG</div><div><div class="ind">Agriculture / Food</div><div class="co">AgroTrade</div></div></div>
      <div class="body"><h3>From local supplier to 4-country exporter</h3><p>How a regional food producer with zero export experience reached four new markets in six months.</p></div>
    </a>
      <a href="/case-meridian" class="cs-card reveal">
      <div class="top"><div class="lg">MX</div><div><div class="ind">Textiles & Apparel</div><div class="co">Meridian Textiles</div></div></div>
      <div class="body"><h3>Building a corporate export wing from scratch</h3><p>How an established manufacturer stood up a dedicated export division and doubled order volume.</p></div>
    </a>
    </div>
  </div>
</section>
</BaseLayout>
