---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { createDatasetJsonLd } from '../lib/seo/jsonLd';

import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
  CLUSTER_LINKS,
  IA_LINK,
} from '../data/menopauseTracker';

const title = "Menopause in the Workplace Legislation 2026";
const description = "Track 2026 workplace laws (IL HB 5284, Rhode Island, SB 790). See why disclosure rules create critical data gaps that leave working women underserved.";

const trackerJsonLd = createDatasetJsonLd({
  name: title,
  description,
  href: "/menopause-legislation-tracker",
  datePublished: "2026-04-15",
  dateModified: "2026-06-29",
  creatorName: "Lozen Advisory LLC",
  about: "https://www.lozenadvisory.com/#lozen-frameworks",
  keywords: [
    "menopause in the workplace",
    "menopause at work",
    "menopause employment law",
    "menopause legislation",
    "menopause workplace policy",
    "Invisible Attrition",
    "Tacere",
  ],
});
const focusClassByLabel: Record<string, string> = {
  Workplace: "lozen-data-badge--focus-workplace",
  Insurance: "lozen-data-badge--focus-insurance",
  Education: "lozen-data-badge--focus-education",
  Omnibus: "lozen-data-badge--focus-omnibus",
  Advisory: "lozen-data-badge--focus-advisory",
  "Military / Veteran": "lozen-data-badge--focus-military",
  "Veteran Care": "lozen-data-badge--focus-veteran-care",
};

const classificationClassByLabel: Record<string, string> = {
  "Dashboard Delay": "lozen-data-badge--classification-dashboard-delay",
  Tacere: "lozen-data-badge--classification-tacere",
  "Invisible Attrition": "lozen-data-badge--classification-invisible-attrition",
  "Outside Scope": "lozen-data-badge--classification-outside-scope",
  "No Classification": "lozen-data-badge--classification-none",
};

const focusBadgeClass = (label: string) =>
  `lozen-data-badge ${focusClassByLabel[label] || "lozen-data-badge--neutral"}`;

const statusModifier = (status: string) => {
  if (/died/i.test(status)) {
    return "lozen-tracker-status--died";
  }

  if (/did not pass|failed|withdrawn/i.test(status)) {
    return "lozen-tracker-status--failed";
  }

  if (/returned|substitute/i.test(status)) {
    return "lozen-tracker-status--returned";
  }

  if (/signed/i.test(status)) {
    return "lozen-tracker-status--signed";
  }

  if (/enacted/i.test(status)) {
    return "lozen-tracker-status--enacted";
  }

  if (/passed/i.test(status)) {
    return "lozen-tracker-status--passed";
  }

  if (/calendar/i.test(status)) {
    return "lozen-tracker-status--calendar";
  }

  if (/committee/i.test(status)) {
    return "lozen-tracker-status--committee";
  }

  if (/introduced|pending/i.test(status)) {
    return "lozen-tracker-status--introduced";
  }

  if (/study|research/i.test(status)) {
    return "lozen-tracker-status--study";
  }

  if (/active|house|senate/i.test(status)) {
    return "lozen-tracker-status--active";
  }

  return "lozen-tracker-status--neutral";
};

const statusCellClass = (_status: string) => "lozen-tracker-status-cell";

const statusBadgeClass = (status: string) =>
  `lozen-tracker-status-badge ${statusModifier(status)}`;

const statusBadgeStyle = (status: string) =>
  status.length > 96
    ? "display:block;width:100%;max-width:none;min-width:0;white-space:normal;text-align:left;border-radius:1rem;padding:0.85rem 1rem;line-height:1.45;"
    : undefined;

const classification = (label: string) => {
  const badgeClass =
    classificationClassByLabel[label] || "lozen-data-badge--classification-none";
  const href =
    CLUSTER_LINKS[label] ||
    (label === "Invisible Attrition" ? IA_LINK : undefined);

  return { badgeClass, href };
};

const classificationBadgeClass = (label: string) =>
  `lozen-data-badge ${classification(label).badgeClass}`;

const sectionId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const standardSections = [
  { title: "Federal", rows: FEDERAL, theme: "federal" },
  { title: "Enacted / Passed", rows: ENACTED, theme: "enacted" },
  { title: "Active / In Committee", rows: ACTIVE, theme: "active" },
];

const trackerStats = [
  { label: "Federal", value: FEDERAL.length },
  { label: "Enacted", value: ENACTED.length },
  { label: "Active", value: ACTIVE.length },
  { label: "Did Not Pass", value: DID_NOT_PASS.length },
  { label: "Advisory", value: ADVISORY.length },
];

const columnDefinitions = [
  ["State / Level", "Jurisdiction."],
  ["Bill", "Bill number and short title."],
  [
    "Focus",
    "Primary domain: Workplace, Insurance, Education, Omnibus, Military / Veteran, Veteran Care, or Advisory.",
  ],
  ["Status", "Current legislative status as of June 29, 2026."],
  [
    "Policy Assumption",
    "The disclosure or participation condition the law requires to activate.",
  ],
  [
    "Governance Blind Spot",
    "The population or condition outside the formal system the law produces.",
  ],
  [
    "Lozen Classification",
    "The Invisible Attrition℠ condition this gap represents.",
  ],
  [
    "Legislative Outcome",
    "Observations from the bill text or legislative record with strategic or analytical value beyond the core gap classification.",
  ],
];


const tableWrapClass = (theme = "default") => `lozen-tracker-table-wrap lozen-tracker-table-wrap--${theme}`;

const tableClass = "lozen-tracker-table";
const compactTableClass = "lozen-tracker-table lozen-tracker-table--compact";

const thClass = "lozen-tracker-th";

const tdStrongClass = "lozen-tracker-td lozen-tracker-td--strong";

const tdMutedClass = "lozen-tracker-td";

const rowClass = "lozen-tracker-row";

const mobileCardClass = "lozen-tracker-mobile-card";

const mobileLabelClass = "lozen-tracker-mobile-label";

const mobileValueClass = "lozen-tracker-mobile-value";
---

<BaseLayout title={title} description={description} jsonLd={trackerJsonLd}>
  <section class="page-hero">
    <div class="grid-bg"></div>
    <div class="wrap inner">
      <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Menopause Legislation Tracker</div>
      <span class="pill">Legislative Efficacy Audit</span>
      <h1>Menopause Legislation Tracker 2026</h1>
      <p class="sub">A 2026 tracker of menopause in the workplace legislation — federal and state, policy assumptions, and analysis of the gaps in data and measurement needed to evaluate impact.</p>
      <p class="tracker-updated">Last updated: June 29, 2026</p>
      <div class="hero-cta">
        <a href="#tracker-data" class="btn btn-accent">View legislation →</a>
        <a href="#tracker-method" class="btn btn-ghost">How to read the tracker</a>
      </div>
    </div>
  </section>

  <section id="main">
    <div class="wrap">
      <div class="center section-head">
        <span class="eyebrow">Tracker overview</span>
        <h2 class="h2">Measuring participation versus unmet need</h2>
        <p class="lead">Menopause legislation creates formal participation pathways, not a full measure of organizational need. The record each pathway produces depends on who enters through a request, claim, clinical encounter, study record, reporting event, or enforcement trigger.</p>
      </div>

      <div class="tracker-stat-grid" aria-label="Tracker record counts">
        {trackerStats.map((stat) => (
          <div class="tracker-stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>

      <div class="tiers tracker-summary-tiers">
        <div class="tier reveal">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg></div>
          <h3>Federal record</h3>
          <div class="who">National proposals and actions</div>
          <div class="price">{FEDERAL.length}<small>tracked entries</small></div>
          <ul class="feats">
            <li>Policy pathway and activation condition</li>
            <li>Population left outside the formal record</li>
            <li>Invisible Attrition℠ classification</li>
          </ul>
          <a href="#federal" class="btn btn-dark">View federal record →</a>
        </div>

        <div class="tier featured reveal">
          <span class="badge-top">Core tracker</span>
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M8 3v18"/><path d="M16 3v18"/><path d="M3 9h18"/><path d="M3 15h18"/></svg></div>
          <h3>State legislation</h3>
          <div class="who">Enacted, active, and unsuccessful bills</div>
          <div class="price">{ENACTED.length + ACTIVE.length + DID_NOT_PASS.length}<small>tracked entries</small></div>
          <ul class="feats">
            <li>Current legislative status</li>
            <li>Governance blind spot</li>
            <li>Legislative outcome and strategic signal</li>
          </ul>
          <a href="#tracker-data" class="btn btn-primary">View state record →</a>
        </div>

        <div class="tier reveal">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"/></svg></div>
          <h3>Advisory record</h3>
          <div class="who">Non-legislative instruments</div>
          <div class="price">{ADVISORY.length}<small>tracked entries</small></div>
          <ul class="feats">
            <li>Structural role of the instrument</li>
            <li>Classification within the framework</li>
            <li>Analytical value beyond formal legislation</li>
          </ul>
          <a href="#advisory-instruments" class="btn btn-dark">View advisory record →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="tracker-copy">
        <span class="eyebrow">Executive summary</span>
        <h2 class="h2">Menopause regulations</h2>
        <p>This index applies Lozen Advisory’s <strong>Legislative Efficacy Audit (LEA) Framework</strong> to menopause-related legislation at the federal and state level.</p>
        <p>While menopause at work has become a critical corporate governance issue, traditional legislative compliance models focus on legal visibility rather than operational architecture. The LEA Framework evaluates what a bill practically requires before employer protections, reporting, enforcement, or liability relief can occur.</p>
        <p>This tracker is part of Lozen Advisory’s broader <a href="/disclosure-independent-governance/">Disclosure-Independent Governance℠</a> methodology for evaluating disclosure-dependent workforce policy design, retention risk, and institutional evidence gaps.</p>

        <div class="tracker-copy-card">
          <h3>The Audit Thesis: Measuring Participation vs. Unmet Need</h3>
          <p>Menopause legislation creates formal participation pathways, not a full measure of organizational need. Each state and federal bill modifies an employer or regulatory pathway. The record it produces depends on who enters that pathway through a request, claim, clinical encounter, study record, or reporting event.</p>
        </div>

        <div class="tracker-copy-card">
          <h3>The LEA Framework Core Pillars</h3>
          <p>Every entry in this index is cross-referenced using the Invisible Attrition℠ classification framework to evaluate:</p>
          <ol>
            <li><strong>The Intervention Pathway:</strong> The formal legal or regulatory channel established by the bill.</li>
            <li><strong>The Activation Condition:</strong> The explicit action required by an employee, employer, or agency before the pathway can legally operate.</li>
            <li><strong>The Excluded Cohorts:</strong> The workforce populations structurally left unmeasured when the activation condition goes unmet.</li>
            <li><strong>The Workforce Attrition Risk:</strong> The corporate compliance and human capital costs left completely unpriced by standard risk assessments.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section id="tracker-method">
    <div class="wrap">
      <div class="center section-head">
        <span class="eyebrow">Column definitions</span>
        <h2 class="h2">How the tracker reads menopause legislation</h2>
      </div>
      <dl class="tracker-definition-grid">
        {columnDefinitions.map(([term, definition]) => (
          <div class="tracker-definition-card reveal">
            <dt>{term}</dt>
            <dd>{definition}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="tracker-data" class="band tracker-data-section">
    <div class="wrap">
      <div class="tracker-table-stack">
        {standardSections.map((section) => {
          const id = sectionId(section.title);
          return (
            <section class="tracker-record-section" aria-labelledby={id}>
              <div class="tracker-record-heading">
                <span class="eyebrow">Legislative record</span>
                <h2 class="h2" id={id}>{section.title}</h2>
              </div>

              <div class={tableWrapClass(section.theme)} tabindex="0" role="region" aria-label={`${section.title} legislation table`}>
                <table class={tableClass}>
                  <thead>
                    <tr>
                      <th class={thClass}>Jurisdiction</th>
                      <th class={thClass}>Bill</th>
                      <th class={thClass}>Focus</th>
                      <th class={thClass}>Status</th>
                      <th class={thClass}>Policy Assumption</th>
                      <th class={thClass}>Governance Blind Spot</th>
                      <th class={thClass}>Classification</th>
                      <th class={thClass}>Legislative Outcome</th>
                    </tr>
                  </thead>
                  <tbody>
                    {section.rows.map((row) => {
                      const c = classification(row.classification);
                      return (
                        <tr class={rowClass}>
                          <td class={tdStrongClass}>{row.jurisdiction}</td>
                          <td class={tdStrongClass}>
                            {row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer">{row.bill}</a> : row.bill}
                          </td>
                          <td class={tdStrongClass}><span class={focusBadgeClass(row.focus)}>{row.focus}</span></td>
                          <td class={statusCellClass(row.status)}><span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>{row.status}</span></td>
                          <td class={tdMutedClass}>{row.assumes}</td>
                          <td class={tdMutedClass}>{row.cannotMeasure}</td>
                          <td class={tdStrongClass}>
                            {c.href ? <a href={c.href}><span class={classificationBadgeClass(row.classification)}>{row.classification}</span></a> : <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>}
                          </td>
                          <td class={tdMutedClass}>{row.notes}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              <div class="lozen-tracker-mobile-grid">
                {section.rows.map((row) => {
                  const c = classification(row.classification);
                  return (
                    <article class={mobileCardClass}>
                      <div><p class={mobileLabelClass}>Jurisdiction</p><p class={mobileValueClass}>{row.jurisdiction}</p></div>
                      <div><p class={mobileLabelClass}>Bill</p><p class={mobileValueClass}>{row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer">{row.bill}</a> : row.bill}</p></div>
                      <div class="tracker-mobile-pair">
                        <div><p class={mobileLabelClass}>Focus</p><span class={focusBadgeClass(row.focus)}>{row.focus}</span></div>
                        <div><p class={mobileLabelClass}>Status</p><span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>{row.status}</span></div>
                      </div>
                      <div><p class={mobileLabelClass}>Policy Assumption</p><p class={mobileValueClass}>{row.assumes}</p></div>
                      <div><p class={mobileLabelClass}>Governance Blind Spot</p><p class={mobileValueClass}>{row.cannotMeasure}</p></div>
                      <div><p class={mobileLabelClass}>Classification</p>{c.href ? <a href={c.href}><span class={classificationBadgeClass(row.classification)}>{row.classification}</span></a> : <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>}</div>
                      <div><p class={mobileLabelClass}>Legislative Outcome</p><p class={mobileValueClass}>{row.notes}</p></div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}

        <section class="tracker-record-section" aria-labelledby="did-not-pass">
          <div class="tracker-record-heading">
            <span class="eyebrow">Legislative record</span>
            <h2 class="h2" id="did-not-pass">Did Not Pass</h2>
          </div>

          <div class={tableWrapClass("failed")} tabindex="0" role="region" aria-label="Did Not Pass legislation table">
            <table class={compactTableClass}>
              <thead><tr><th class={thClass}>Jurisdiction</th><th class={thClass}>Bill</th><th class={thClass}>Focus</th><th class={thClass}>Status</th><th class={thClass}>Assumed</th><th class={thClass}>Failure Confirms</th><th class={thClass}>Legislative Outcome</th></tr></thead>
              <tbody>
                {DID_NOT_PASS.map((row) => (
                  <tr class={rowClass}>
                    <td class={tdStrongClass}>{row.jurisdiction}</td>
                    <td class={tdStrongClass}>{row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer">{row.bill}</a> : row.bill}</td>
                    <td class={tdStrongClass}><span class={focusBadgeClass(row.focus)}>{row.focus}</span></td>
                    <td class={statusCellClass(row.status)}><span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>{row.status}</span></td>
                    <td class={tdMutedClass}>{row.assumed}</td>
                    <td class={tdMutedClass}>{row.failureConfirms}</td>
                    <td class={tdMutedClass}>{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="lozen-tracker-mobile-grid">
            {DID_NOT_PASS.map((row) => (
              <article class={mobileCardClass}>
                <div><p class={mobileLabelClass}>Jurisdiction</p><p class={mobileValueClass}>{row.jurisdiction}</p></div>
                <div><p class={mobileLabelClass}>Bill</p><p class={mobileValueClass}>{row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer">{row.bill}</a> : row.bill}</p></div>
                <div class="tracker-mobile-pair"><div><p class={mobileLabelClass}>Focus</p><span class={focusBadgeClass(row.focus)}>{row.focus}</span></div><div><p class={mobileLabelClass}>Status</p><span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>{row.status}</span></div></div>
                <div><p class={mobileLabelClass}>Assumed</p><p class={mobileValueClass}>{row.assumed}</p></div>
                <div><p class={mobileLabelClass}>Failure Confirms</p><p class={mobileValueClass}>{row.failureConfirms}</p></div>
                <div><p class={mobileLabelClass}>Legislative Outcome</p><p class={mobileValueClass}>{row.notes}</p></div>
              </article>
            ))}
          </div>
        </section>

        <section class="tracker-record-section" aria-labelledby="advisory-instruments">
          <div class="tracker-record-heading">
            <span class="eyebrow">Non-legislative instruments</span>
            <h2 class="h2" id="advisory-instruments">Advisory / Non-Legislative Instruments</h2>
          </div>

          <div class={tableWrapClass("advisory")} tabindex="0" role="region" aria-label="Advisory and non-legislative instruments table">
            <table class={compactTableClass}>
              <thead><tr><th class={thClass}>Jurisdiction</th><th class={thClass}>Instrument</th><th class={thClass}>Focus</th><th class={thClass}>Status</th><th class={thClass}>Structural Role</th><th class={thClass}>Classification</th><th class={thClass}>Legislative Outcome</th></tr></thead>
              <tbody>
                {ADVISORY.map((row) => {
                  const c = classification(row.classification);
                  return (
                    <tr class={rowClass}>
                      <td class={tdStrongClass}>{row.jurisdiction}</td>
                      <td class={tdStrongClass}>{row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer">{row.instrument}</a> : row.instrument}</td>
                      <td class={tdStrongClass}><span class={focusBadgeClass(row.focus)}>{row.focus}</span></td>
                      <td class={statusCellClass(row.status)}><span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>{row.status}</span></td>
                      <td class={tdMutedClass}>{row.structuralRole}</td>
                      <td class={tdStrongClass}>{c.href ? <a href={c.href}><span class={classificationBadgeClass(row.classification)}>{row.classification}</span></a> : <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>}</td>
                      <td class={tdMutedClass}>{row.notes}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div class="lozen-tracker-mobile-grid">
            {ADVISORY.map((row) => {
              const c = classification(row.classification);
              return (
                <article class={mobileCardClass}>
                  <div><p class={mobileLabelClass}>Jurisdiction</p><p class={mobileValueClass}>{row.jurisdiction}</p></div>
                  <div><p class={mobileLabelClass}>Instrument</p><p class={mobileValueClass}>{row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer">{row.instrument}</a> : row.instrument}</p></div>
                  <div class="tracker-mobile-pair"><div><p class={mobileLabelClass}>Focus</p><span class={focusBadgeClass(row.focus)}>{row.focus}</span></div><div><p class={mobileLabelClass}>Status</p><span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>{row.status}</span></div></div>
                  <div><p class={mobileLabelClass}>Structural Role</p><p class={mobileValueClass}>{row.structuralRole}</p></div>
                  <div><p class={mobileLabelClass}>Classification</p>{c.href ? <a href={c.href}><span class={classificationBadgeClass(row.classification)}>{row.classification}</span></a> : <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>}</div>
                  <div><p class={mobileLabelClass}>Legislative Outcome</p><p class={mobileValueClass}>{row.notes}</p></div>
                </article>
              );
            })}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="tracker-copy">
        <span class="eyebrow">Closing analysis</span>
        <h2 class="h2">The measurement gap is structural</h2>
        <p>The pattern across every entry in this table is consistent with the framework this site has developed across its policy series. Each law creates a formal system. Each formal system activates at the point of participation. The population that has already decided participation carries more professional risk than it returns is not reflected in the utilization data, the leave records, the accommodation requests, or the workforce study findings any of these laws will produce.</p>
        <p>That population is not small. The Michigan Women's Commission found that fewer than one in five women disclosed their menopause status at work. The Bank of America and National Menopause Foundation study found a 73-point gap between HR managers who believed they were having the conversation and employees who said they had it.</p>
        <p>The legislation is real. The protections are meaningful for the women who use them. The measurement gap is structural.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="center section-head">
        <span class="eyebrow">How we work</span>
        <h2 class="h2">From legislative record to organizational decision</h2>
      </div>
      <div class="steps">
        <div class="step reveal"><div class="num">1</div><h3>Define the question</h3><p>Identify the workplace, retention, measurement, or governance question the organization needs the legislation to answer.</p></div>
        <div class="step reveal"><div class="num">2</div><h3>Read the pathway</h3><p>Examine what action must occur before a protection, report, study, accommodation, or enforcement mechanism becomes visible.</p></div>
        <div class="step reveal"><div class="num">3</div><h3>Identify the gap</h3><p>Determine which workforce populations and organizational costs remain outside the formal record.</p></div>
        <div class="step reveal"><div class="num">4</div><h3>Translate the exposure</h3><p>Convert the legislative signal into retention, workforce materiality, evidence, and governance implications.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="center section-head"><span class="eyebrow">FAQ</span><h2 class="h2">Common questions</h2></div>
      <div class="faq">
        <div class="qa reveal"><h4>What does this tracker cover?</h4><p>It tracks federal and state menopause-related legislation and selected non-legislative instruments, with emphasis on workplace pathways, activation conditions, measurement gaps, and Invisible Attrition℠ risk.</p></div>
        <div class="qa reveal"><h4>Is the tracker legal advice?</h4><p>No. It is independent legislative and governance analysis. Organizations should consult qualified counsel for legal interpretation and compliance obligations.</p></div>
        <div class="qa reveal"><h4>Why does the tracker examine disclosure and participation?</h4><p>Because many formal protections and datasets begin only after an employee, employer, agency, clinician, or study participant takes a specified action. That activation condition determines what the resulting record can and cannot measure.</p></div>
        <div class="qa reveal"><h4>How is this connected to Invisible Attrition℠?</h4><p>The tracker identifies where formal systems fail to capture workforce erosion that occurs before a traditional retention event, accommodation request, leave record, claim, or disclosure becomes visible.</p></div>
      </div>
    </div>
  </section>

