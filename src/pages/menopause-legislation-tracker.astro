---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
import MenopauseTrackerGrid from '../components/MenopauseTrackerGrid.astro';
import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
} from '../data/menopauseTracker';

const pageTitle =
  'Menopause Legislation Tracker 2026 | Lozen Advisory';

const pageDescription =
  'Track federal and state menopause legislation, policy assumptions, governance blind spots, Lozen classifications, and legislative outcomes.';

const canonicalUrl =
  'https://www.lozenadvisory.com/menopause-legislation-tracker/';

const standardSections = [
  { title: 'Federal', rows: FEDERAL, theme: 'federal' },
  { title: 'Enacted / Passed', rows: ENACTED, theme: 'enacted' },
  { title: 'Active / In Committee', rows: ACTIVE, theme: 'active' },
];

const trackerStats = [
  { label: 'Federal', value: FEDERAL.length },
  { label: 'Enacted', value: ENACTED.length },
  { label: 'Active', value: ACTIVE.length },
  { label: 'Did Not Pass', value: DID_NOT_PASS.length },
  { label: 'Advisory', value: ADVISORY.length },
];

const columnDefinitions = [
  ['State / Level', 'Jurisdiction.'],
  ['Bill', 'Bill number and short title.'],
  [
    'Focus',
    'Primary domain: Workplace, Insurance, Education, Omnibus, Military / Veteran, Veteran Care, or Advisory.',
  ],
  ['Status', 'Current legislative status.'],
  [
    'Policy Assumption',
    'The disclosure or participation condition the law requires to activate.',
  ],
  [
    'Governance Blind Spot',
    'The population or condition outside the formal system the law produces.',
  ],
  [
    'Lozen Classification',
    'The Invisible Attrition℠ condition this gap represents.',
  ],
  [
    'Legislative Outcome',
    'Observations from the bill text or legislative record with strategic or analytical value beyond the core gap classification.',
  ],
];

const faqItems = [
  {
    question: 'What does the menopause legislation tracker measure?',
    answer:
      'The tracker records the legislative focus, current status, policy assumption, governance blind spot, Lozen classification, and legislative outcome associated with each federal, state, or advisory instrument.',
  },
  {
    question: 'What is a policy assumption?',
    answer:
      'A policy assumption is the condition the legislation expects to produce change. Examples include employee disclosure, use of a formal benefit or accommodation process, provider education, insurance coverage, research funding, or participation in a public data system.',
  },
  {
    question: 'What is a governance blind spot?',
    answer:
      'A governance blind spot is a population, condition, delay, or institutional risk that the policy mechanism cannot reliably detect or measure. An instrument may create a valid intervention while still leaving material exposure outside the resulting record.',
  },
  {
    question: 'What do the Lozen classifications mean?',
    answer:
      'The classifications connect each instrument to the structural conditions identified through Lozen Advisory’s Invisible Attrition℠ analysis, including delayed detection, strategic non-disclosure, unmeasured attrition, and instruments outside the framework’s analytical scope.',
  },
  {
    question: 'How often is the tracker updated?',
    answer:
      'Lozen Advisory updates the tracker when bill text, legislative status, enactment, committee action, or other material policy information changes.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Menopause Legislation Tracker 2026',
  description: pageDescription,
  url: canonicalUrl,
  creator: {
    '@type': 'Organization',
    name: 'Lozen Advisory',
    url: 'https://www.lozenadvisory.com/',
  },
  author: {
    '@type': 'Person',
    name: 'Akilah E. Kamaria',
  },
  isAccessibleForFree: true,
  keywords: [
    'menopause legislation',
    'workplace menopause legislation',
    'menopause policy',
    'menopause benefits',
    'Invisible Attrition',
    'workforce governance',
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <section class="page-hero">
    <div class="grid-bg"></div>

    <div class="wrap inner">
      <div class="crumb">
        <a href="/">Home</a>
        &nbsp;/&nbsp;
        Menopause Legislation Tracker
      </div>

      <span class="pill">Lozen Advisory Policy Intelligence</span>

      <h1>Menopause Legislation Tracker 2026</h1>

      <p class="sub">
        A governance audit of federal and state menopause legislation, the
        policy assumptions each instrument relies upon, and the populations or
        institutional risks its formal record cannot see.
      </p>

    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Tracker coverage</span>

        <h2 class="h2">Current menopause policy record</h2>
      </div>

      <div class="steps" aria-label="Tracker record counts">
        {
          trackerStats.map((stat) => (
            <article class="step">
              <span class="num">{stat.value}</span>
              <h3>{stat.label}</h3>
            </article>
          ))
        }
      </div>

      <div class="hero-cta">
        <a href="#tracker" class="btn btn-accent">
          View the tracker →
        </a>

        <a href="#methodology" class="btn btn-ghost">
          Read the methodology
        </a>
      </div>
    </div>
  </section>

  <section class="tracker-introduction">
    <div class="wrap tracker-introduction-grid">
      <div>
        <span class="eyebrow">Executive Summary</span>

        <h2 class="h2">Menopause Regulations</h2>
      </div>

      <div class="prose tracker-introduction-copy">
        <p>
          This index applies Lozen Advisory’s <strong>Legislative Efficacy Audit (LEA) Framework</strong> to menopause-related legislation at the federal and state level.
        </p>

        <p>
          While menopause at work has become a critical corporate governance issue, traditional legislative compliance models focus on legal visibility rather than operational architecture. The LEA Framework evaluates what a bill practically requires before employer protections, reporting, enforcement, or liability relief can occur.
        </p>

        <p>
          This tracker is part of Lozen Advisory’s broader <a href="/disclosure-independent-governance/">Disclosure-Independent Governance℠</a> methodology for evaluating disclosure-dependent workforce policy design, retention risk, and institutional evidence gaps.
        </p>

        <h3>The Audit Thesis: Measuring Participation vs. Unmet Need</h3>

        <p>
          Menopause legislation creates formal participation pathways, not a full measure of organizational need. Each state and federal bill modifies an employer or regulatory pathway. The record it produces depends on who enters that pathway through a request, claim, clinical encounter, study record, or reporting event.
        </p>

        <h3>The LEA Framework Core Pillars</h3>

        <p>
          Every entry in this index is cross-referenced using the Invisible Attrition℠ classification framework to evaluate:
        </p>

        <ol>
          <li><strong>The Intervention Pathway:</strong> The formal legal or regulatory channel established by the bill.</li>
          <li><strong>The Activation Condition:</strong> The explicit action required by an employee, employer, or agency before the pathway can legally operate.</li>
          <li><strong>The Excluded Cohorts:</strong> The workforce populations structurally left unmeasured when the activation condition goes unmet.</li>
          <li><strong>The Workforce Attrition Risk:</strong> The corporate compliance and human capital costs left completely unpriced by standard risk assessments.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="tracker-method">
    <div class="wrap">
      <div class="center section-head">
        <span class="eyebrow">Column Definitions</span>

        <h2 class="h2">How the Tracker Reads Menopause Legislation</h2>
      </div>

      <div class="steps">
        {
          columnDefinitions.map(([term, definition], index) => (
            <article class="step">
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{term}</h3>
              <p>{definition}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="tracker"
    class="tracker-section"
  >
    <div class="wrap tracker-wrap">
      <div class="section-head tracker-heading">
        <span class="eyebrow">Interactive tracker</span>

        <h2 class="h2">
          Federal, state, and advisory menopause policy
        </h2>

        <p class="lead">
          Search, sort, filter, resize columns, and open the underlying
          legislative sources directly from the table.
        </p>
      </div>

      <MenopauseTrackerGrid />
    </div>
  </section>

  <section
    id="methodology"
    class="tracker-method"
  >
    <div class="wrap">
      <div class="center section-head">
        <span class="eyebrow">Analytical process</span>

        <h2 class="h2">
          How Lozen Advisory evaluates each instrument
        </h2>
      </div>

      <div class="steps">
        <article class="step reveal">
          <span class="num">01</span>

          <h3>Identify the mechanism</h3>

          <p>
            Determine whether the instrument creates research, education,
            insurance coverage, workplace accommodation, clinical training,
            public awareness, data infrastructure, or advisory guidance.
          </p>
        </article>

        <article class="step reveal">
          <span class="num">02</span>

          <h3>Locate the activation condition</h3>

          <p>
            Identify what must occur before the mechanism can operate,
            including disclosure, diagnosis, provider recognition, formal
            participation, appropriation, or implementation.
          </p>
        </article>

        <article class="step reveal">
          <span class="num">03</span>

          <h3>Test the resulting record</h3>

          <p>
            Examine which experiences, delays, departures, or harms remain
            outside the evidence produced by the legislative mechanism.
          </p>
        </article>

        <article class="step reveal">
          <span class="num">04</span>

          <h3>Classify the structural gap</h3>

          <p>
            Connect the record to the relevant Lozen Advisory condition,
            including Dashboard Delay, Tacere, Invisible Attrition℠, or Outside
            Scope.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="tracker-analysis">
    <div class="wrap analysis-grid">
      <div>
        <span class="eyebrow">Why the distinction matters</span>

        <h2 class="h2">
          Legislative activity and institutional visibility are not the same
          result
        </h2>
      </div>

      <div class="prose analysis-copy">
        <p>
          A research mandate may produce findings without changing present
          clinical practice. A workplace protection may apply after disclosure
          without reaching employees who decide disclosure is professionally
          unsafe. A public dashboard may measure formal healthcare encounters
          without capturing career loss that occurs outside the clinical
          system.
        </p>

        <blockquote>
          <p>
            A policy can accurately measure participation in the system it
            created while remaining structurally blind to the people who never
            enter that system.
          </p>
        </blockquote>

        <p>
          The tracker does not treat these limitations as proof that the
          legislation has no value. It distinguishes the stated intervention
          from the complete population and governance outcome the intervention
          may be assumed to represent.
        </p>

        <p>
          That distinction is central to
          <a href="/disclosure-independent-governance/">
            <strong>Disclosure-Independent Governance℠</strong>
          </a>:
          institutional risk should not become visible only after an individual
          discloses, enters a formal process, experiences measurable
          deterioration, or leaves.
        </p>
      </div>
    </div>
  </section>

  <section class="tracker-faq">
    <div class="wrap">
      <div class="center section-head">
        <span class="eyebrow">Tracker FAQ</span>

        <h2 class="h2">
          How to read the legislation analysis
        </h2>
      </div>

      <div
        class="faq"
        aria-label="Menopause legislation tracker frequently asked questions"
      >
        {
          faqItems.map((item) => (
            <details class="qa reveal">
              <summary>
                <h4>{item.question}</h4>
              </summary>

              <div class="qa-body">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaStrip
    title="What does your current workforce record fail to show?"
    description="Lozen Advisory examines the institutional gaps between formal policy, visible participation, workforce capacity, and the evidence used to govern risk."
    primaryHref="/service-cfo-market-intelligence/"
    primaryLabel="Explore CFO Market Intelligence →"
    secondaryHref="/contact/"
    secondaryLabel="Contact Lozen Advisory"
    paddedTop={false}
  />
</BaseLayout>

<style>
  .tracker-introduction-grid,
  .analysis-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .tracker-introduction-copy,
  .analysis-copy {
    max-width: 48rem;
  }

  .tracker-introduction-copy p:last-child,
  .analysis-copy p:last-child {
    margin-bottom: 0;
  }

  .tracker-section,
  .tracker-faq {
    background: #DBF3FE;
  }

  .tracker-wrap {
    max-width: 96rem;
  }

  .tracker-heading {
    max-width: 52rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .tracker-method {
    background: var(--paper-2);
  }

  .tracker-analysis {
    background: #06172f;
    color: var(--paper-2);
  }

  .tracker-analysis .eyebrow,
  .tracker-analysis .h2,
  .tracker-analysis .analysis-copy,
  .tracker-analysis .analysis-copy p {
    color: var(--paper-2);
  }

  .tracker-analysis .analysis-copy a {
    color: var(--paper-2);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .tracker-analysis .analysis-copy blockquote {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 4px solid var(--accent);
  }

  .tracker-analysis .analysis-copy blockquote p {
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    line-height: 1.35;
  }

  .faq details.qa {
    display: block;
  }

  .faq details.qa summary {
    cursor: pointer;
    list-style: none;
  }

  .faq details.qa summary::-webkit-details-marker {
    display: none;
  }

  .faq details.qa summary h4 {
    margin: 0;
  }

  .faq details.qa summary h4::after {
    content: '+';
    float: right;
    margin-left: 1rem;
    font-family: var(--sans);
  }

  .faq details.qa[open] summary h4::after {
    content: '−';
  }

  .qa-body {
    padding-top: 1rem;
  }

  .qa-body p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .tracker-introduction-grid,
    .analysis-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
