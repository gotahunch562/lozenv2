---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { formatPostDate, postHref, sortPostsByDate } from '../lib/blog';

const posts = sortPostsByDate(await getCollection('blog'));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id);

---

<BaseLayout title="Blog — Export Insights & Guides — Exporta Global" description="Practical guides on finding buyers, shipping, licensing, and getting paid in international trade.">
  <section class="page-hero">
    <div class="grid-bg"></div>
    <div class="wrap inner" style="text-align:center;margin:0 auto">
      <span class="pill">Export insights &amp; practical guides</span>
      <h1>The Exporta Global Blog</h1>
      <p class="sub" style="margin-left:auto;margin-right:auto">Actionable advice on finding buyers, entering markets, shipping correctly, and getting paid — written by people who do this every day.</p>
    </div>
  </section>

  <section style="padding-bottom:0">
    <div class="wrap">
      <div class="cat-bar" id="catBar">
        {['All', 'Buyer Sourcing', 'Market Research', 'Logistics', 'Payments', 'Compliance'].map((tag) => (
          <a href="#" class={tag === 'All' ? 'active' : ''} data-filter={tag}>{tag}</a>
        ))}
      </div>
      {
        featured && (
          <a href={postHref(featured.id)} class="feature-post reveal" data-tag={featured.data.tag}>
            <div class="thumb">
              {featured.data.image ? (
                <img src={featured.data.image} alt="" />
              ) : (
                <span>{featured.data.emoji}</span>
              )}
            </div>
            <div class="body">
              <span class="tag">Featured · {featured.data.tag}</span>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.description}</p>
              <div class="post-meta">
                <span class="av">DC</span> Daniel Carter · {formatPostDate(featured.data.pubDate)} · {featured.data.readTime}
              </div>
            </div>
          </a>
        )
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">Latest articles</span><h2 class="h2">Fresh from the desk</h2></div>
      <div class="post-grid" id="postGrid">
        {latest.map((post) => (
          <a href={postHref(post.id)} class="post-card reveal" data-tag={post.data.tag}>
            <div class="thumb">
              {post.data.image ? (
                <img src={post.data.image} alt="" loading="lazy" />
              ) : null}
            </div>
            <div class="body">
              <span class="tag">{post.data.tag}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="post-meta">
                <span class="av">DC</span> {formatPostDate(post.data.pubDate)} · {post.data.readTime}
              </div>
            </div>
          </a>
        ))}
        <a href="#" class="post-card reveal" data-tag="Market Research">
          <div class="thumb"><img src="/blog/market-ready-product.png" alt="" loading="lazy" /></div>
          <div class="body">
            <span class="tag">Market Research</span>
            <h3>5 Signs a Market Is Ready for Your Product</h3>
            <p>Before you spend a cent entering a country, check for these demand signals.</p>
            <div class="post-meta"><span class="av">DC</span> May 6, 2026 · 6 min read</div>
          </div>
        </a>
        <a href="#" class="post-card reveal" data-tag="Compliance">
          <div class="thumb"><img src="/blog/export-license.png" alt="" loading="lazy" /></div>
          <div class="body">
            <span class="tag">Compliance</span>
            <h3>Can You Legally Export Without Your Own License?</h3>
            <p>Yes — in many cases. Here's how license-free export routes actually work.</p>
            <div class="post-meta"><span class="av">DC</span> Apr 28, 2026 · 5 min read</div>
          </div>
        </a>
        <a href="#" class="post-card reveal" data-tag="Logistics">
          <div class="thumb"><img src="/blog/shipment-checklist.png" alt="" loading="lazy" /></div>
          <div class="body">
            <span class="tag">Logistics</span>
            <h3>The First-Time Exporter's Shipment Checklist</h3>
            <p>A step-by-step checklist to get your first shipment out the door cleanly.</p>
            <div class="post-meta"><span class="av">DC</span> Apr 19, 2026 · 6 min read</div>
          </div>
        </a>
      </div>
      <div id="noResults" style="display:none;text-align:center;padding:48px 0;color:var(--muted);font-size:16px">
        No posts found in this category yet — check back soon.
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="news reveal">
        <h2>Get export tips in your inbox</h2>
        <p>One practical email a week on finding buyers, shipping, and getting paid. No spam.</p>
        <form id="newsForm"><input type="email" required placeholder="you@email.com" /><button class="btn btn-dark" type="submit">Subscribe</button></form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ---- Blog category filter ----
  const catBar = document.getElementById('catBar');
  const postGrid = document.getElementById('postGrid');
  const featuredPost = document.querySelector('.feature-post') as HTMLElement | null;
  const noResults = document.getElementById('noResults');

  function filterPosts(activeFilter: string) {
    if (!postGrid) return;

    const cards = postGrid.querySelectorAll<HTMLElement>('.post-card');
    let visibleCount = 0;

    cards.forEach((card) => {
      const tag = card.dataset.tag ?? '';
      const match = activeFilter === 'All' || tag === activeFilter;
      card.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    // Show/hide featured post
    if (featuredPost) {
      const ftag = featuredPost.dataset.tag ?? '';
      const fmatch = activeFilter === 'All' || ftag === activeFilter;
      featuredPost.style.display = fmatch ? '' : 'none';
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  if (catBar) {
    catBar.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a[data-filter]') as HTMLElement | null;
      if (!link) return;
      e.preventDefault();

      // Update active state
      catBar.querySelectorAll('a').forEach((a) => a.classList.remove('active'));
      link.classList.add('active');

      filterPosts(link.dataset.filter ?? 'All');
    });
  }
</script>
