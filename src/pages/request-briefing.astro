---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  'Board AI Governance Advisory',
  'CFO AI Intelligence',
  'Algorithmic Accountability Risk',
  'Name Standard℠ Advisory',
  'AI Workforce Materiality Briefing',
  'General inquiry',
];

const companySizes = [
  'Under 500',
  '500–2,000',
  '2,000–10,000',
  '10,000+',
];

const requested = Astro.url.searchParams.get('service');

const selectedService = services.includes(requested ?? '')
  ? requested
  : 'General inquiry';
---

<BaseLayout
  title="Request a Strategic Briefing | Lozen Advisory"
  description="Request a Lozen Advisory briefing on AI governance, workforce materiality, retention risk, or related advisory topics."
>
  <section class="page-hero">
    <div class="grid-bg"></div>

    <div class="wrap inner">
      <div class="crumb">
        <a href="/">Home</a> &nbsp;/&nbsp; Request a Briefing
      </div>

      <span class="pill">Request Briefing</span>

      <h1>Request a <span class="hl">Briefing</span></h1>

      <p class="sub">
        Request a Lozen Advisory briefing on AI governance, workforce
        materiality, retention risk, or related advisory topics.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap two-col">
      <div class="reveal">
        <span class="eyebrow">Briefing details</span>

        <h2 class="h2">Tell us what you&apos;re solving</h2>

        <form
          class="form"
          id="consultForm"
          method="POST"
          action="/api/inquiry"
          style="margin-top:26px;padding:0;background:none;border:none"
        >
          <input type="hidden" name="type" value="briefing" />
          <input type="hidden" name="name" id="briefing-name" value="" />

          <div
            aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"
          >
            <label>
              Website
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <div class="row2">
            <div class="field">
              <label for="briefing-first-name">First name</label>
              <input
                id="briefing-first-name"
                name="firstName"
                type="text"
                required
                autocomplete="given-name"
                placeholder="First name"
              />
            </div>

            <div class="field">
              <label for="briefing-last-name">Last name</label>
              <input
                id="briefing-last-name"
                name="lastName"
                type="text"
                required
                autocomplete="family-name"
                placeholder="Last name"
              />
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="briefing-role">Title</label>
              <input
                id="briefing-role"
                name="role"
                type="text"
                required
                autocomplete="organization-title"
                placeholder="e.g. General Counsel, CFO"
              />
            </div>

            <div class="field">
              <label for="briefing-company">Company</label>
              <input
                id="briefing-company"
                name="company"
                type="text"
                required
                autocomplete="organization"
                placeholder="Company name"
              />
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="briefing-email">Email address</label>
              <input
                id="briefing-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
              />
            </div>

            <div class="field">
              <label for="briefing-phone">Phone number</label>
              <input
                id="briefing-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="Phone number"
              />
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="briefing-company-size">Company size</label>

              <select
                id="briefing-company-size"
                name="companySize"
                required
              >
                <option value="" disabled selected>
                  Select company size
                </option>

                {companySizes.map((size) => (
                  <option value={size}>{size}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="briefing-subject">Which briefing?</label>

              <select
                id="briefing-subject"
                name="subject"
                required
              >
                {services.map((service) => (
                  <option
                    value={service}
                    selected={service === selectedService}
                  >
                    {service}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div class="field">
            <label for="briefing-message">
              What are you trying to solve?
            </label>

            <textarea
              id="briefing-message"
              name="message"
              rows="4"
              required
              placeholder="Describe what you are seeing inside your organization"
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn btn-primary"
            id="consultSubmit"
          >
            Request Briefing →
          </button>

          <p
            id="consultError"
            role="alert"
            hidden
            style="margin-top:14px"
          ></p>
        </form>

        <div
          class="form-success"
          id="consultSuccess"
          hidden
        >
          <div class="big">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="width:52px;height:52px;color:var(--accent)"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
          </div>

          <h3>Your briefing request was sent</h3>

          <p>
            Lozen Advisory will review your inquiry directly and follow up to
            schedule a conversation.
          </p>
        </div>
      </div>

      <div class="reveal">
        <div
          class="ag"
          style="flex-direction:column;align-items:stretch"
        >
          <h4 style="margin-bottom:14px">What happens next</h4>

          <div
            class="checklist"
            style="grid-template-columns:1fr"
          >
            <div class="check">
              <span class="ck">✓</span>
              <p>We review your submission within one business day.</p>
            </div>

            <div class="check">
              <span class="ck">✓</span>
              <p>
                If there&apos;s a fit, we&apos;ll reach out to schedule a
                confidential conversation.
              </p>
            </div>

            <div class="check">
              <span class="ck">✓</span>
              <p>
                No obligation. No information shared outside this inquiry.
              </p>
            </div>
          </div>
        </div>

        <div
          class="ag"
          style="flex-direction:column;align-items:stretch;margin-top:16px"
        >
          <h4>Prefer email?</h4>

          <p style="color:var(--muted);margin:8px 0 12px">
            Reach us directly at
          </p>

          <a
            href="mailto:hello@lozenadvisory.com"
            style="font-weight:700;color:var(--accent)"
          >
            hello@lozenadvisory.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#consultForm');
    const success = document.querySelector<HTMLElement>('#consultSuccess');
    const errorMessage = document.querySelector<HTMLElement>('#consultError');
    const submitButton =
      document.querySelector<HTMLButtonElement>('#consultSubmit');
    const firstName =
      document.querySelector<HTMLInputElement>('#briefing-first-name');
    const lastName =
      document.querySelector<HTMLInputElement>('#briefing-last-name');
    const fullName =
      document.querySelector<HTMLInputElement>('#briefing-name');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) {
        return;
      }

      if (fullName) {
        fullName.value = `${firstName?.value ?? ''} ${lastName?.value ?? ''}`.trim();
      }

      if (errorMessage) {
        errorMessage.hidden = true;
        errorMessage.textContent = '';
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';
      }

      try {
        const response = await fetch('/api/inquiry', {
          method: 'POST',
          body: new FormData(form),
          headers: {
            Accept: 'application/json',
          },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(
            result?.error || 'The briefing request could not be sent.',
          );
        }

        form.reset();
        form.hidden = true;

        if (success) {
          success.hidden = false;
        }
      } catch (error) {
        if (errorMessage) {
          errorMessage.textContent =
            error instanceof Error
              ? error.message
              : 'The briefing request could not be sent.';

          errorMessage.hidden = false;
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Request Briefing →';
        }
      }
    });
  </script>
</BaseLayout>
