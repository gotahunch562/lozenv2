---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  'Board AI Governance Advisory',
  'CFO Market Intelligence',
  'Algorithmic Accountability Risk',
  'Name Standard℠ Advisory',
  'AI Workforce Materiality Briefing',
  'General inquiry',
];

const companySizes = ['Under 500', '500–2,000', '2,000–10,000', '10,000+'];

const requested = Astro.url.searchParams.get('service');
const selectedService = services.includes(requested ?? '') ? requested : 'General inquiry';
---

<BaseLayout title="Request a Strategic Briefing | Lozen Advisory" description="Request a Lozen Advisory briefing on AI governance, workforce materiality, retention risk, or related advisory topics.">
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Request a Briefing</div>
    <span class="pill">Request Briefing</span>
    <h1>Request a <span class="hl">Briefing</span></h1>
    <p class="sub">Request a Lozen Advisory briefing on AI governance, workforce materiality, retention risk, or related advisory topics.</p>
  </div>
</section>

<section>
  <div class="wrap two-col">
    <div class="reveal">
      <span class="eyebrow">Briefing details</span>
      <h2 class="h2">Tell us what you're solving</h2>
      <form class="form" id="consultForm" style="margin-top:26px;padding:0;background:none;border:none">
        <div class="row2">
          <div class="field"><label>First name</label><input type="text" required placeholder="First name" /></div>
          <div class="field"><label>Last name</label><input type="text" required placeholder="Last name" /></div>
        </div>
        <div class="row2">
          <div class="field"><label>Title</label><input type="text" required placeholder="e.g. General Counsel, CFO" /></div>
          <div class="field"><label>Company</label><input type="text" required placeholder="Company name" /></div>
        </div>
        <div class="row2">
          <div class="field"><label>Email address</label><input type="email" required placeholder="you@company.com" /></div>
          <div class="field"><label>Phone number</label><input type="tel" required placeholder="Phone number" /></div>
        </div>
        <div class="row2">
          <div class="field">
            <label>Company size</label>
            <select required>
              <option value="" disabled selected>Select company size</option>
              {companySizes.map((size) => (<option>{size}</option>))}
            </select>
          </div>
          <div class="field">
            <label>Which briefing?</label>
            <select>
              {services.map((service) => (
                <option selected={service === selectedService}>{service}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="field"><label>What are you trying to solve?</label><textarea rows="4" placeholder="Describe what you are seeing inside your organization"></textarea></div>
        <button type="submit" class="btn btn-primary">Request Briefing →</button>
      </form>
      <div class="form-success" id="consultSuccess">
        <div class="big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:52px;height:52px;color:var(--accent)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
        <h3>Your briefing request was sent</h3>
        <p>Lozen Advisory will review your inquiry directly and follow up to schedule a conversation.</p>
      </div>
    </div>

    <div class="reveal">
      <div class="ag" style="flex-direction:column;align-items:stretch">
        <h4 style="margin-bottom:14px">What happens next</h4>
        <div class="checklist" style="grid-template-columns:1fr">
          <div class="check"><span class="ck">✓</span><p>We review your submission within one business day.</p></div>
          <div class="check"><span class="ck">✓</span><p>If there's a fit, we'll reach out to schedule a confidential conversation.</p></div>
          <div class="check"><span class="ck">✓</span><p>No obligation. No information shared outside this inquiry.</p></div>
        </div>
      </div>
      <div class="ag" style="flex-direction:column;align-items:stretch;margin-top:16px">
        <h4>Prefer email?</h4>
        <p style="color:var(--muted);margin:8px 0 12px">Reach us directly at</p>
        <a href="mailto:hello@lozenadvisory.com" style="font-weight:700;color:var(--accent)">hello@lozenadvisory.com</a>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
