---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout title="Case Studies — Exporta Global" description="Real results — how we've helped businesses find buyers, enter markets, and export profitably.">
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Case Studies</div>
    <span class="pill">Proven results</span>
    <h1>Real businesses, real export results</h1>
    <p class="sub">We measure our work by outcomes — orders shipped, markets entered, margins protected. Explore how we've helped businesses like yours.</p>
  </div>
</section>

<section id="main">
  <div class="wrap">
    <div class="cs-grid">
      <a href="/case-agrotrade" class="cs-card reveal">
      <div class="top"><div class="lg">AG</div><div><div class="ind">Agriculture / Food</div><div class="co">AgroTrade</div></div></div>
      <div class="body">
        <h3>From local supplier to 4-country exporter</h3>
        <p>How a regional food producer with zero export experience reached four new markets in six months.</p>
        <div class="cs-stats"><div class="s"><div class="v">4</div><div class="l">new markets</div></div><div class="s"><div class="v">6 mo</div><div class="l">to first order</div></div><div class="s"><div class="v">+38%</div><div class="l">revenue</div></div></div>
      </div>
    </a><a href="/case-meridian" class="cs-card reveal">
      <div class="top"><div class="lg">MX</div><div><div class="ind">Textiles & Apparel</div><div class="co">Meridian Textiles</div></div></div>
      <div class="body">
        <h3>Building a corporate export wing from scratch</h3>
        <p>How an established manufacturer stood up a dedicated export division and doubled order volume.</p>
        <div class="cs-stats"><div class="s"><div class="v">12</div><div class="l">staff trained</div></div><div class="s"><div class="v">9</div><div class="l">export markets</div></div><div class="s"><div class="v">2x</div><div class="l">order volume</div></div></div>
      </div>
    </a><a href="/case-pioneer" class="cs-card reveal">
      <div class="top"><div class="lg">PW</div><div><div class="ind">Handicrafts</div><div class="co">Pioneer Works</div></div></div>
      <div class="body">
        <h3>Exporting without an in-house license</h3>
        <p>How a small craft business started exporting — legally — without holding its own export license.</p>
        <div class="cs-stats"><div class="s"><div class="v">3</div><div class="l">countries</div></div><div class="s"><div class="v">0</div><div class="l">license needed</div></div><div class="s"><div class="v">90d</div><div class="l">to first sale</div></div></div>
      </div>
    </a><a href="/case-northwind" class="cs-card reveal">
      <div class="top"><div class="lg">NW</div><div><div class="ind">Industrial Goods</div><div class="co">Northwind Co.</div></div></div>
      <div class="body">
        <h3>Fixing payments and protecting margin</h3>
        <p>How an established exporter stopped losing money to payment delays and protected its margin.</p>
        <div class="cs-stats"><div class="s"><div class="v">100%</div><div class="l">on-time pay</div></div><div class="s"><div class="v">+15%</div><div class="l">net margin</div></div><div class="s"><div class="v">5</div><div class="l">LC deals</div></div></div>
      </div>
    </a>
    </div>
    <p class="compare-note" style="margin-top:36px">These examples are illustrative. <a href="/contact" style="color:var(--brand);font-weight:700">Talk to us</a> about results for your specific product and markets.</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="center section-head"><span class="eyebrow">In their words</span><h2 class="h2">What clients say</h2></div>
    <div class="t-grid">
      <div class="t-card reveal"><div class="stars">★★★★★</div><p>"We sent our first international shipment by following their guidance. Finding a buyer was the biggest challenge — and they solved it for us."</p><div class="who"><div class="av">RH</div><div><div class="nm">Robert Hayes</div><div class="rl">Founder, AgroTrade</div></div></div></div>
      <div class="t-card reveal"><div class="stars">★★★★★</div><p>"Setting up an export wing in our company was a game-changer. The whole process is finally clear."</p><div class="who"><div class="av">SA</div><div><div class="nm">Sarah Adams</div><div class="rl">Director, Meridian Textiles</div></div></div></div>
      <div class="t-card reveal"><div class="stars">★★★★★</div><p>"I didn't know you could export without your own license. Now I'm shipping regularly to three countries."</p><div class="who"><div class="av">TM</div><div><div class="nm">Tom Mitchell</div><div class="rl">Founder, Pioneer Works</div></div></div></div>
    </div>
  </div>
</section>

<CtaStrip
  title="Ready to take your products global?"
  description="Book a free consultation and we'll map out exactly how we can help you export profitably."
  primaryHref="/contact"
  primaryLabel="Get a Free Consultation →"
  secondaryHref="/webinar"
  secondaryLabel="Join the free webinar"
  paddedTop={false}
/>
</BaseLayout>
