---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/case-studies.css';
import { CASE_STUDIES } from '../data/caseStudies';
import { createCollectionPageJsonLd } from '../lib/seo/jsonLd';

const pageTitle =
  'Evidence-Based Responsibility Reconstruction℠ Case Studies | Lozen Advisory';
const pageDescription =
  'Four Utah AI healthcare case studies examining whether responsibility for AI-mediated decisions can be reconstructed from the public record.';

const jsonLd = createCollectionPageJsonLd({
  title: pageTitle,
  description: pageDescription,
  href: '/case-studies/',
  items: CASE_STUDIES.map((study) => ({
    title: study.title,
    href: study.href,
    description: study.indexSummary,
  })),
  breadcrumbs: [
    { name: 'Home', href: '/' },
    { name: 'Case Studies', href: '/case-studies/' },
  ],
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/case-studies/"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <section class="page-hero case-study-index-hero">
    <div class="grid-bg"></div>

    <div class="wrap inner">
      <div class="crumb">
        <a href="/">Home</a>
        &nbsp;/&nbsp;
        Case Studies
      </div>

      <span class="pill">Algorithmic Accountability</span>

      <h1>
        Evidence-Based Responsibility Reconstruction℠
        <span class="hl">Case Studies</span>
      </h1>
    </div>
  </section>

  <section id="case-study-index">
    <div class="wrap">
      <div class="case-study-index-heading">
        <div>
          <h2 class="h2">
            Four Utah AI Pilots. Four Different Responsibility Gaps.
          </h2>
        </div>

        <p>
          Utah authorized AI to conduct student mental-health conversations,
          renew prescriptions, evaluate dental radiographs, and authorize
          psychiatric medication refills. Each pilot includes a human name,
          escalation path, second check, or review process. These case studies
          test whether those safeguards preserve responsibility—or preserve
          only the appearance of human oversight after judgment has moved to an
          AI system.
        </p>
      </div>

      <div class="cs-grid" role="list">
        {
          CASE_STUDIES.map((study) => (
            <a
              href={study.href}
              class="cs-card reveal"
              role="listitem"
              aria-label={`Open ${study.title} case study`}
            >
              <div class="top">
                <div class="lg" aria-hidden="true">{study.initials}</div>
                <div>
                  <div class="ind">{study.aiUse}</div>
                  <div class="co">{study.shortName}</div>
                </div>
              </div>

              <div class="body">
                <h2>{study.title}</h2>
                <p>{study.indexSummary}</p>

                <span class="case-study-card-link">Read case study →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="article-body">
        <h2>A Safeguard Is Not a Responsibility Record</h2>

        <p>
          Doctronic and Legion Health preserve a physician’s name when the
          physician may not review the individual prescription decision.
          ElizaChat promises human escalation while controlling the threshold
          that determines whether a student reaches a human. Dentacor allows
          agreement between a hygienist and an AI system to prevent dentist
          review—even when both could share the same error.
        </p>

        <p>
          The cases do not ask only whether a safeguard exists. They ask what
          the surviving record could prove after harm: who authorized the AI’s
          role, who decided the controls were sufficient, whether a human
          actually exercised judgment, who could have intervened, and who
          controlled the evidence needed to explain what happened.
        </p>

        <p>
          <a href="/blog/evidence-based-responsibility-reconstruction/">
            Read the Evidence-Based Responsibility Reconstruction℠ method
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
