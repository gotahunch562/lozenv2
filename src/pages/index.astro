---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
---

<BaseLayout title="Lozen Advisory —" description="Advisory that helps boards identify systemic risks that legacy measurement systems are structurally blind to.">
<!-- ============ HERO ============ -->
<section class="hero">
  <div class="grid-bg"></div>
  <div class="wrap hero-inner">
    <div>
      <span class="pill"><span class="dot"></span> Trusted advisory for boards</span>
      <h1>Take Your Products <span class="hl">to the World</span></h1>
      <p class="sub">Corporate boards are being asked to oversee AI systems that increasingly act inside enterprise workflows, shape decisions, and create records.</p>
      <div class="hero-cta">
        <a href="/#contact" class="btn btn-accent">Request A Briefing →</a>
        <a href="/#services" class="btn btn-ghost">Explore Services</a>
      </div>
      <div class="trustline">
        <span class="stars">★★★★★</span> &nbsp;Trusted by 500+ exporters • Shipments to 40+ countries
      </div>
    </div>
    <div class="hero-card reveal">
  <h4>What Boards Need to Answer</h4>

  <div class="mini-stats">
    <div class="mini">
      <div class="n">01</div>
      <div class="l">Who owned the decision?</div>
    </div>

    <div class="mini">
      <div class="n">02</div>
      <div class="l">What evidence was available?</div>
    </div>

    <div class="mini">
      <div class="n">03</div>
      <div class="l">Who had authority to approve or refuse?</div>
    </div>

    <div class="mini">
      <div class="n">04</div>
      <div class="l">What can the operating record prove?</div>
    </div>
  </div>

  <div class="flags">
    <span>AI accountability</span>
    <span>Board oversight</span>
    <span>Human attribution</span>
    <span>Workforce materiality</span>
  </div>
</div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee">
  <div class="track">
    <span>ALGORITHMIC ACCOUNTABILITY</span><span>•</span>
    <span>BOARD AI GOVERNANCE</span><span>•</span>
    <span>CFO MARKET INTELLIGENCE</span><span>•</span>
    <span>THE NAME STANDARD℠</span><span>•</span>
    <span>AI WORKFORCE MATERIALITY</span><span>•</span>

    <span>ALGORITHMIC ACCOUNTABILITY</span><span>•</span>
    <span>BOARD AI GOVERNANCE</span><span>•</span>
    <span>CFO MARKET INTELLIGENCE</span><span>•</span>
    <span>THE NAME STANDARD℠</span><span>•</span>
    <span>AI WORKFORCE MATERIALITY</span><span>•</span>
  </div>
</div>

<!-- ============ STATS ============ -->
<section class="stats-band" style="padding:64px 0">
  <div class="wrap">
    <div class="stats-grid reveal">
      <div class="stat"><div class="num"><span data-count="15">0</span></div><div class="cap">Years working in global trade</div></div>
      <div class="stat"><div class="num"><span data-count="500">0</span><span class="plus">+</span></div><div class="cap">Businesses helped to export</div></div>
      <div class="stat"><div class="num"><span data-count="3000">0</span><span class="plus">+</span></div><div class="cap">Shipments to 40+ countries</div></div>
      <div class="stat"><div class="num"><span data-count="98">0</span><span class="plus">%</span></div><div class="cap">Client satisfaction rate</div></div>
    </div>
  </div>
</section>

<!-- ============ SERVICES (BENTO) ============ -->
<section id="services">
  <div class="wrap">
    <div class="center" style="max-width:680px">
      <span class="eyebrow">What we do</span>
      <h2 class="h2">Everything you need to export — in one place</h2>
      <p class="lead">From your first market study to recurring international shipments, our team handles the complexity so you can focus on growth.</p>
    </div>
    <div class="bento">
      <a href="/service-buyer-sourcing" class="card span3 feat reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></div><h3>Global Buyer Sourcing</h3><p>We find and qualify verified international buyers for your products using a proven, data-driven outreach method.</p><span class="go">Learn more →</span></a>
      <a href="/service-market-research" class="card span3 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div><h3>Market Research & Entry</h3><p>Know exactly which countries demand your product and how to enter them with a clear go-to-market strategy.</p><span class="go">Learn more →</span></a>
      <a href="/service-licensing-documentation" class="card span2 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></div><h3>Licensing & Documentation</h3><p>End-to-end support for export licenses, certificates of origin, and customs paperwork.</p><span class="go">Learn more →</span></a>
      <a href="/service-shipping-logistics" class="card span2 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div><h3>Shipping & Logistics</h3><p>Freight forwarding, incoterms, and shipment coordination handled correctly, every time.</p><span class="go">Learn more →</span></a>
      <a href="/service-payments-lc" class="card span2 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div><h3>Payments & LC</h3><p>Secure your payments with the right terms — letters of credit, advance, and escrow guidance.</p><span class="go">Learn more →</span></a>
    </div>
  </div>
</section>

<!-- ============ PAIN ============ -->
<section class="pain">
  <div class="wrap">
    <div class="center" style="max-width:720px">
      <span class="eyebrow">The real problem</span>
      <h2 class="h2">Exporting is simple and exciting — once you know how</h2>
      <p class="lead">But after working with hundreds of businesses, we see the same costly mistakes again and again:</p>
    </div>
    <div class="pain-grid">
      <div class="pain-item reveal"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></span><p>Most businesses never manage to find a reliable overseas buyer.</p></div>
      <div class="pain-item reveal"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span><p>No clear strategy for which market to enter, or how.</p></div>
      <div class="pain-item reveal"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 18.5A2 2 0 0 0 6.5 21.5h11a2 2 0 0 0 1.78-2.9l-5.069-8.077A2 2 0 0 1 14 9.527V2"/><line x1="8.5" y1="2" x2="15.5" y2="2"/></svg></span><p>Little idea how to market a product internationally.</p></div>
      <div class="pain-item reveal"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span><p>Shipments go wrong because the process isn't followed correctly.</p></div>
      <div class="pain-item reveal"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><p>Too much spent on licensing, leaving no budget for other costs.</p></div>
      <div class="pain-item reveal"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg></span><p>No roadmap to profit — so they ship, but the business never grows.</p></div>
    </div>
    <div class="center" style="margin-top:46px">
      <p class="lead" style="color:rgba(255,255,255,.85);font-weight:600">You only need one thing — the right guidance from the right experts.</p>
    </div>
  </div>
</section>

<!-- ============ PROCESS / LIVE BANNER ============ -->
<section id="process" style="padding-bottom:0">
  <div class="wrap">
    <div class="live reveal">
      <div>
        <span class="badge"><span class="d"></span> FREE WEEKLY WEBINAR</span>
        <h3>Join our live export strategy session — every Friday</h3>
        <p class="when">Ask your questions directly and get real-time guidance from our trade experts.</p>
      </div>
      <div class="right"><a href="/webinar" class="btn btn-dark">Reserve your spot →</a></div>
    </div>
  </div>
</section>

<!-- ============ FOUNDER / ABOUT ============ -->
<section id="founder">
  <div class="wrap mentor-wrap">
    <div class="mentor-photo reveal">
      <FounderPortrait variant="mentor" alt="Daniel Carter, Founder &amp; Lead Consultant" />
      <div class="mentor-badge">
        <div><div class="nm">Daniel Carter</div><div class="rl">Founder &amp; Lead Consultant</div></div>
        <div style="text-align:right"><div class="big">20+</div><div class="rl">years exporting</div></div>
      </div>
    </div>
    <div class="reveal">
      <span class="eyebrow">Meet your lead consultant</span>
      <h2 class="h2">Hi, I'm Akilah E. Kamaria</h2>
      <p class="mentor-quote">I started my career two decades ago as a Data Analyst. Since then I've helped enterprises reconstruct the technical, financial, and decision history of enterprise systems when the organization lacks a complete, reliable, or standardized record..<br><br>In our programs and consultancy, I share everything I've learned across 20 years — including the hard lessons — so your companies can grow and avoid the common AI pitfalls.</p>
      <div class="mentor-sign">— Daniel Carter</div>
    </div>
  </div>
</section>

<!-- ============ GAINS ============ -->
<section style="padding-top:0">
  <div class="wrap">
    <div class="center" style="max-width:680px">
      <span class="eyebrow">When you work with us</span>
      <h2 class="h2">What you'll get</h2>
    </div>
    <div class="gain-grid">
      <div class="gain reveal"><span class="ck">✓</span><p>A complete A-to-Z export roadmap</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>A method to export even with zero experience</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>A proven system for finding verified buyers</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>Market analysis that wins real orders</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>Full support from sourcing to shipment to payment</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>How to export with or without your own license</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>Strategies to turn exports into sustained profit</p></div>
      <div class="gain reveal"><span class="ck">✓</span><p>Help building and running an in-house export wing</p></div>
    </div>
  </div>
</section>

<!-- ============ CONSULTANCY ============ -->
<section id="consultancy" class="stats-band">
  <div class="wrap">
    <div class="center" style="max-width:680px">
      <span class="eyebrow">Done-for-you engagements</span>
      <h2 class="h2">Consultancy — we work as your export team</h2>
      <p class="lead">Choose the level of support that fits your business stage and goals.</p>
    </div>
    <div class="bento" style="margin-top:42px">
      <a href="/consultancy" class="card span2 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div><h3>Mentorship Program</h3><p>One-on-one guidance to launch and scale your export business.</p><span class="go">Get pricing →</span></a>
      <a href="/consultancy" class="card span2 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div><h3>SME Consultancy</h3><p>A full 12-month engagement to build a profitable export channel for small and mid-sized businesses.</p><span class="go">Get pricing →</span></a>
      <a href="/consultancy" class="card span2 reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div><h3>Corporate Consultancy</h3><p>End-to-end setup and management of a corporate export wing, tailored to your operation.</p><span class="go">Get pricing →</span></a>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section id="testi">
  <div class="wrap">
    <div class="center" style="max-width:680px">
      <span class="eyebrow">Results</span>
      <h2 class="h2">What our clients say</h2>
    </div>
    <div class="t-grid">
      <div class="t-card reveal"><div class="stars">★★★★★</div><p>"We sent our first international shipment by following their guidance. Finding a buyer was the biggest challenge — and they solved it for us."</p><div class="who"><div class="av">RH</div><div><div class="nm">Robert Hayes</div><div class="rl">SME Exporter</div></div></div></div>
      <div class="t-card reveal"><div class="stars">★★★★★</div><p>"Setting up an export wing in our company was a game-changer with their consultancy. The whole process is finally clear."</p><div class="who"><div class="av">SA</div><div><div class="nm">Sarah Adams</div><div class="rl">Director, Corporate Client</div></div></div></div>
      <div class="t-card reveal"><div class="stars">★★★★★</div><p>"I didn't know you could export without your own license. Now I'm shipping regularly to three countries."</p><div class="who"><div class="av">TM</div><div><div class="nm">Tom Mitchell</div><div class="rl">Founder, Craft Exports</div></div></div></div>
    </div>
    <p class="center lead" style="margin-top:46px;font-size:15px">A few of the companies we've recently served —</p>
    <div class="logos"><div class="lg">Acme Group</div><div class="lg">Northwind Co.</div><div class="lg">AgroTrade</div><div class="lg">Meridian Intl.</div><div class="lg">Pioneer Works</div></div>
  </div>
</section>

<!-- ============ CTA / CONTACT ============ -->
<section id="contact" class="cta-sec">
  <div class="wrap cta-wrap">
    <div>
      <span class="eyebrow">Get started</span>
      <h2 class="h2">Stay ahead of AI Accountability & Attribution Issues</h2>
      <p class="lead">We developed the frameworks, tools, and capabilities that turn AI from a source of uncertainty into a competitive advantage. Learn how we can help your organization.</p>
      <div class="contact-list">
        <a href="tel:+10000000000"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg></span> +1 (000) 000-0000</a>
        <a href="mailto:hello@example.com"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span> hello@example.com</a>
        <a href="#"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span> 123 Trade Avenue, Your City</a>
      </div>
    </div>
    <form class="form" >
      <h3>Request a Consultation</h3>
      <p>Fill in your details — we'll reach out within 24 hours.</p>
      <div class="row2">
        <div class="field"><label>Your name</label><input type="text" placeholder="Full name" /></div>
        <div class="field"><label>Phone</label><input type="tel" placeholder="Phone number" /></div>
      </div>
      <div class="row2">
        <div class="field"><label>Email</label><input type="email" placeholder="you@email.com" /></div>
        <div class="field"><label>Company</label><input type="text" placeholder="Company name" /></div>
      </div>
      <div class="field">
        <label>I'm interested in</label>
        <select>
          <option>Mentorship Program</option>
          <option>SME Consultancy (12 months)</option>
          <option>Corporate Consultancy (12 months)</option>
          <option>Free consultation / Webinar</option>
        </select>
      </div>
      <div class="field"><label>Message</label><textarea rows="3" placeholder="Tell us about your product and goals"></textarea></div>
      <button class="btn btn-primary">Submit Request →</button>
    </form>
  </div>
</section>

<!-- ============ FOOTER ============ -->
</BaseLayout>
