---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout title="Consultancy & Programs — Exporta Global" description="Done-for-you export consultancy — Mentorship, SME, and Corporate engagements to build a profitable export operation.">
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; Consultancy</div>
    <span class="pill">Done-for-you engagements</span>
    <h1>Consultancy that works as your export team</h1>
    <p class="sub">Whether you're shipping for the first time or scaling a corporate export wing, we offer a level of support that fits — from one-on-one mentorship to full done-for-you operations.</p>
    <div class="hero-cta">
      <a href="/contact" class="btn btn-accent">Get a Free Consultation →</a>
      <a href="/#main" class="btn btn-ghost">Learn more</a>
    </div>
  </div>
</section>

<section id="main">
  <div class="wrap">
    <div class="center section-head"><span class="eyebrow">Programs</span><h2 class="h2">Choose your level of support</h2><p class="lead">Every engagement is built around your product, markets, and goals. Pricing is tailored after a free discovery call.</p></div>
    <div class="tiers">
      <div class="tier reveal">
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div>
      <h3>Mentorship Program</h3>
      <div class="who">For first-time & solo exporters</div>
      <div class="price">Custom<small>per program</small></div>
      <ul class="feats"><li>One-on-one guidance from a 20-year trade expert</li><li>A personalized export roadmap for your product</li><li>Buyer-finding & market-entry coaching</li><li>Help with documentation & first shipment</li><li>Direct access for questions between sessions</li><li>Accountability to keep you moving</li></ul>
      <a href="/contact" class="btn btn-dark">Apply for Mentorship →</a>
    </div><div class="tier featured reveal"><span class="badge-top">Most popular</span>
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div>
      <h3>SME Consultancy</h3>
      <div class="who">For small & mid-sized businesses</div>
      <div class="price">12-month<small>engagement</small></div>
      <ul class="feats"><li>Everything in Mentorship, plus:</li><li>Done-with-you buyer sourcing</li><li>Market research & entry strategy</li><li>Shipping, licensing & payment setup</li><li>A built export channel you can run</li><li>Quarterly reviews & optimization</li></ul>
      <a href="/contact" class="btn btn-primary">Book an SME Call →</a>
    </div><div class="tier reveal">
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
      <h3>Corporate Consultancy</h3>
      <div class="who">For corporates & large operations</div>
      <div class="price">12-month<small>engagement</small></div>
      <ul class="feats"><li>Everything in SME, plus:</li><li>End-to-end export wing setup</li><li>Team training & process documentation</li><li>Dedicated account management</li><li>Multi-market expansion planning</li><li>Executive reporting & KPIs</li></ul>
      <a href="/contact" class="btn btn-dark">Talk to Sales →</a>
    </div>
    </div>
    <p class="compare-note">Not sure which fits? <a href="/contact" style="color:var(--brand);font-weight:700">Book a free call</a> and we'll recommend the right path.</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="center section-head"><span class="eyebrow">How we work</span><h2 class="h2">A clear, proven process</h2></div>
    <div class="steps">
      <div class="step reveal"><div class="num">1</div><h3>Discovery call</h3><p>We learn your product, capacity, and goals — free, no obligation.</p></div>
      <div class="step reveal"><div class="num">2</div><h3>Tailored plan</h3><p>We design an engagement and roadmap matched to your business.</p></div>
      <div class="step reveal"><div class="num">3</div><h3>Execution</h3><p>We work alongside you — sourcing, shipping, licensing, payments.</p></div>
      <div class="step reveal"><div class="num">4</div><h3>Scale</h3><p>We optimize and expand into new markets as you grow.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="center section-head"><span class="eyebrow">FAQ</span><h2 class="h2">Common questions</h2></div>
    <div class="faq">
      <div class="qa reveal"><h4>How is pricing determined?</h4><p>Pricing depends on your product, target markets, and the scope of support. After a free discovery call we send a tailored proposal — no surprises.</p></div>
      <div class="qa reveal"><h4>Can I start with mentorship and upgrade later?</h4><p>Absolutely. Many clients begin with the Mentorship Program and move into SME or Corporate consultancy as they grow.</p></div>
      <div class="qa reveal"><h4>Do you work with businesses outside my country?</h4><p>Yes — we support exporters across 40+ markets. Engagements are run remotely with regular live sessions.</p></div>
    </div>
  </div>
</section>

<CtaStrip
  title="Ready to take your products global?"
  description="Book a free consultation and we'll map out exactly how we can help you export profitably."
  primaryHref="/contact"
  primaryLabel="Get a Free Consultation →"
  secondaryHref="/webinar"
  secondaryLabel="Join the free webinar"
  paddedTop={false}
/>
</BaseLayout>
