---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaStrip from '../../components/CtaStrip.astro';

const description = 'Lozen Advisory founder Akilah E. Kamaria will speak to Pepperdine University students about how AI is changing brand, search, website design, and digital marketing for the agentic internet.';

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Marketing for the Agentic Internet: How AI Is Changing Brand, Search, and Website Design',
  description,
  startDate: '2026-09-03',
  eventStatus: 'https://schema.org/EventScheduled',
  organizer: {
    '@type': 'CollegeOrUniversity',
    name: 'Pepperdine University',
    url: 'https://www.pepperdine.edu/',
  },
  performer: {
    '@type': 'Person',
    name: 'Akilah E. Kamaria',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.lozenadvisory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Events', item: 'https://www.lozenadvisory.com/events/' },
    { '@type': 'ListItem', position: 3, name: 'Marketing for the Agentic Internet at Pepperdine University', item: 'https://www.lozenadvisory.com/events/marketing-for-the-agentic-internet-pepperdine-university/' },
  ],
};
---

<BaseLayout title="Marketing for the Agentic Internet at Pepperdine University | Lozen Advisory" description={description}>
<script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="wrap inner">
    <div class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/events/">Events</a> &nbsp;/&nbsp; Pepperdine University</div>
    <span class="pill">Speaking Engagement · September 3, 2026</span>
    <h1>Marketing for the Agentic Internet: How AI Is Changing Brand, Search, and Website Design</h1>
    <p class="sub">Pepperdine University — AI for Digital Marketing</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="article-body">
      <p><strong>Audience:</strong> AI for Digital Marketing students<br>
      <strong>Format:</strong> Guest classroom lecture<br>
      <strong>Date:</strong> September 3, 2026</p>

      <p>Lozen Advisory founder Akilah E. Kamaria will speak to Pepperdine University students about how AI is changing the structure of the internet and what those changes mean for digital marketing.</p>

      <p>The session will examine what brand means when AI systems increasingly discover, interpret, recommend, and act on online information. Topics include AI optimization for websites, machine-readable authority and entity signals, the changing role of search, and how website design changes when businesses must serve both human visitors and AI systems acting on their behalf.</p>
    </div>
  </div>
</section>

<CtaStrip
  title="Invite Lozen Advisory into the room."
  description="For speaking invitations, hosted sessions, conferences, panels, or private leadership conversations, contact Lozen Advisory with the event context, audience, timing, and topic."
  primaryHref="/contact/"
  primaryLabel="Contact Lozen Advisory →"
/>
</BaseLayout>
