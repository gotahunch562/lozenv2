---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Board advisory on AI accountability, human attribution, governance evidence gaps, and workforce materiality.',
  canonical,
  ogImage = '/lozen-advisory-social.webp',
  ogImageAlt = 'Lozen Advisory',
  ogType = 'website',
} = Astro.props;

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  Astro.site ?? Astro.url.origin
);

const ogImageUrl = new URL(
  ogImage,
  Astro.site ?? Astro.url.origin
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Lozen Advisory" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png"
    />

    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png"
    />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />

    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Tenor+Sans&display=swap"
      rel="stylesheet"
   />

   <Analytics />
</head>

<body>
  <Header isHome={isHome} />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <SiteScripts />
</body>
</html>
