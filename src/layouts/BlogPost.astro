---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import CtaStrip from '../components/CtaStrip.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { formatPostDate } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, relatedPosts } = Astro.props;
const { title, description, tag, image, pubDate, readTime, lead } = post.data;
const pageTitle = `${title} — Exporta Global`;
---

<BaseLayout title={pageTitle} description={description}>
  <section class="article-hero">
    <div class="grid-bg"></div>
    <div class="wrap inner">
      <span class="tag">{tag}</span>
      <h1>{title}</h1>
      <div class="byline">
        <FounderPortrait variant="byline" class="av" alt="Daniel Carter" />
        <span>Daniel Carter</span><span class="dot">•</span><span>{formatPostDate(pubDate)}</span><span class="dot">•</span><span>{readTime}</span>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      {image ? (
        <img class="article-cover" src={image} alt="" />
      ) : null}
      <article class="article-body">
        <p class="article-lead">{lead}</p>
        <slot />
      </article>
      <AuthorBox />
    </div>
  </section>

  <CtaStrip
    title="Want help applying this to your business?"
    description="Book a free consultation and we'll map out your next steps toward exporting profitably."
    primaryHref="/contact"
    secondaryHref="/webinar"
  />

  <RelatedPosts posts={relatedPosts} />
</BaseLayout>
