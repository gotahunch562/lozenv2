---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import CtaStrip from '../components/CtaStrip.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { formatPostDate } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, relatedPosts } = Astro.props;

const {
  title,
  seoTitle,
  description,
  metaDescription,
  category,
  tag,
  image,
  imageAlt,
  pubDate,
  dateModified,
  readTime,
  lead,
} = post.data;

const postCategory = category ?? tag ?? '';
const pageTitle = seoTitle ?? `${title} — Lozen Advisory`;
const pageDescription = metaDescription ?? description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={image}
  ogImageAlt={imageAlt ?? title}
  ogType="article"
>
  <section class="article-hero">
    <div class="grid-bg"></div>

    <div class="wrap inner">
      {
        postCategory && (
          <span class="tag">{postCategory}</span>
        )
      }

      <h1>{title}</h1>

      <div class="byline">
        <FounderPortrait
          variant="byline"
          class="av"
          alt="Akilah E. Kamaria"
        />

        <span>Akilah E. Kamaria</span>

        <span class="dot">•</span>

        <span>{formatPostDate(pubDate)}</span>

        {
          dateModified && (
            <>
              <span class="dot">•</span>
              <span>
                Updated {formatPostDate(dateModified)}
              </span>
            </>
          )
        }

        {
          readTime && (
            <>
              <span class="dot">•</span>
              <span>{readTime}</span>
            </>
          )
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      {
        image ? (
          <img
            class="article-cover"
            src={image}
            alt={imageAlt ?? ''}
          />
        ) : null
      }

      <article class="article-body">
        <p class="article-lead">{lead}</p>
        <slot />
      </article>

      <AuthorBox />
    </div>
  </section>

  <CtaStrip
    title="Need a clearer view of your governance exposure?"
    description="Request a Lozen Advisory briefing to examine the accountability, measurement, and institutional risks affecting your organization."
    primaryHref="/request-briefing"
    secondaryHref="/services"
  />

  <RelatedPosts posts={relatedPosts} />
</BaseLayout>
