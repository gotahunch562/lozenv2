---
import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
} from '../data/menopauseTracker';

type TrackerRow = {
  recordGroup: string;
  jurisdiction: string;
  item: string;
  url?: string;
  focus: string;
  status: string;
  policyAssumption: string;
  governanceBlindSpot: string;
  classification: string;
  legislativeOutcome: string;
};

const standardRows = (
  recordGroup: string,
  rows: typeof FEDERAL | typeof ENACTED | typeof ACTIVE,
): TrackerRow[] =>
  rows.map((row) => ({
    recordGroup,
    jurisdiction: row.jurisdiction,
    item: row.bill,
    url: row.url,
    focus: row.focus,
    status: row.status,
    policyAssumption: row.assumes,
    governanceBlindSpot: row.cannotMeasure,
    classification: row.classification,
    legislativeOutcome: row.notes,
  }));

const didNotPassRows: TrackerRow[] = DID_NOT_PASS.map((row) => ({
  recordGroup: 'Did Not Pass',
  jurisdiction: row.jurisdiction,
  item: row.bill,
  url: row.url,
  focus: row.focus,
  status: row.status,
  policyAssumption: row.assumed,
  governanceBlindSpot: row.failureConfirms,
  classification: 'No Classification',
  legislativeOutcome: row.notes,
}));

const advisoryRows: TrackerRow[] = ADVISORY.map((row) => ({
  recordGroup: 'Advisory',
  jurisdiction: row.jurisdiction,
  item: row.instrument,
  url: row.url,
  focus: row.focus,
  status: row.status,
  policyAssumption: row.structuralRole,
  governanceBlindSpot: '',
  classification: row.classification,
  legislativeOutcome: row.notes,
}));

const rows: TrackerRow[] = [
  ...standardRows('Federal', FEDERAL),
  ...standardRows('Enacted / Passed', ENACTED),
  ...standardRows('Active / In Committee', ACTIVE),
  ...didNotPassRows,
  ...advisoryRows,
];

const gridId = 'menopause-tracker-grid';
const dataId = 'menopause-tracker-data';
---

<div>
  <label for="menopause-tracker-search">Search tracker</label>

  <input
    id="menopause-tracker-search"
    type="search"
    placeholder="Search jurisdiction, bill, status, focus, or classification"
    autocomplete="off"
  />

  <div
    id={gridId}
    aria-label="Menopause legislation tracker"
    style="width: 100%; height: 760px;"
  ></div>

  <noscript>
    <p>JavaScript is required to use the interactive legislation tracker.</p>
  </noscript>
</div>

<div
  id="menopause-detail-backdrop"
  style="display:none;position:fixed;inset:0;background:rgba(6,23,47,.45);z-index:90"
></div>

<aside
  id="menopause-detail-panel"
  aria-hidden="true"
  style="display:none;position:fixed;top:0;right:0;bottom:0;width:min(480px,100%);background:var(--paper-2);z-index:91;overflow-y:auto;box-shadow:-24px 0 60px -24px rgba(6,23,47,.35);padding:32px 28px"
>
  <button
    type="button"
    id="menopause-detail-close"
    aria-label="Close detail panel"
    style="position:absolute;top:20px;right:20px;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--paper-2);cursor:pointer;font-size:16px;line-height:1;color:var(--ink)"
  >×</button>

  <div id="menopause-detail-body"></div>
</aside>

<script
  id={dataId}
  type="application/json"
  set:html={JSON.stringify(rows).replace(/</g, '\\u003c')}
></script>

<script>
  import {
    AllCommunityModule,
    ModuleRegistry,
    createGrid,
    themeQuartz,
  } from 'ag-grid-community';

  ModuleRegistry.registerModules([AllCommunityModule]);

  const gridElement = document.getElementById('menopause-tracker-grid');
  const dataElement = document.getElementById('menopause-tracker-data');
  const searchInput = document.getElementById('menopause-tracker-search');

  if (
    gridElement instanceof HTMLDivElement &&
    dataElement instanceof HTMLScriptElement
  ) {
    const rowData = JSON.parse(dataElement.textContent || '[]');

    const lozenTheme = themeQuartz
      .withParams({
        accentColor: '#F28422',
        backgroundColor: '#FFFFFF',
        borderColor: '#000000',
        browserColorScheme: 'inherit',
        columnBorder: true,
        fontFamily: {
          googleFont: 'DM Sans',
        },
        foregroundColor: '#1B1212',
        headerBackgroundColor: '#06172F',
        headerFontWeight: 600,
        headerTextColor: '#FFFFFF',
      });

    const linkRenderer = (params) => {
      const value = params.value ?? '';
      const url = params.data?.url;

      if (!url) {
        return value;
      }

      const link = document.createElement('a');

      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = value;

      return link;
    };

    const columnDefs = [
      {
        field: 'recordGroup',
        headerName: 'Record Group',
        width: 190,
      },
      {
        field: 'jurisdiction',
        headerName: 'Jurisdiction',
        width: 170,
      },
      {
        field: 'item',
        headerName: 'Bill / Instrument',
        width: 280,
        cellRenderer: linkRenderer,
        tooltipField: 'item',
      },
      {
        field: 'focus',
        headerName: 'Focus',
        width: 210,
        tooltipField: 'focus',
      },
      {
        field: 'status',
        headerName: 'Status',
        width: 220,
        tooltipField: 'status',
      },
      {
        field: 'policyAssumption',
        headerName: 'Policy Assumption / Structural Role',
        width: 360,
        tooltipField: 'policyAssumption',
      },
      {
        field: 'governanceBlindSpot',
        headerName: 'Governance Blind Spot / Failure Confirms',
        width: 380,
        tooltipField: 'governanceBlindSpot',
      },
      {
        field: 'classification',
        headerName: 'Classification',
        width: 220,
        tooltipField: 'classification',
      },
      {
        field: 'legislativeOutcome',
        headerName: 'Legislative Outcome',
        width: 400,
        tooltipField: 'legislativeOutcome',
      },
    ];

    const gridApi = createGrid(gridElement, {
      theme: lozenTheme,
      rowData,
      columnDefs,

      defaultColDef: {
        sortable: true,
        filter: true,
        resizable: true,
      },

      pagination: true,
      paginationPageSize: 20,
      paginationPageSizeSelector: [10, 20, 50],

      getRowId: (params) =>
        [
          params.data.recordGroup,
          params.data.jurisdiction,
          params.data.item,
        ].join('::'),

      onRowClicked: (params) => openDetailPanel(params.data),
    });

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', () => {
        gridApi.setGridOption('quickFilterText', searchInput.value);
      });
    }

    // ---- Row detail panel ----
    const detailFields = [
      { key: 'recordGroup', label: 'Record Group' },
      { key: 'jurisdiction', label: 'Jurisdiction' },
      { key: 'item', label: 'Bill / Instrument' },
      { key: 'focus', label: 'Focus' },
      { key: 'status', label: 'Status' },
      { key: 'policyAssumption', label: 'Policy Assumption / Structural Role' },
      { key: 'governanceBlindSpot', label: 'Governance Blind Spot / Failure Confirms' },
      { key: 'classification', label: 'Classification' },
      { key: 'legislativeOutcome', label: 'Legislative Outcome' },
    ];

    const backdrop = document.getElementById('menopause-detail-backdrop');
    const panel = document.getElementById('menopause-detail-panel');
    const panelBody = document.getElementById('menopause-detail-body');
    const closeBtn = document.getElementById('menopause-detail-close');

    function escapeHtml(value) {
      const div = document.createElement('div');
      div.textContent = value ?? '';
      return div.innerHTML;
    }

    function openDetailPanel(data) {
      if (!(panel instanceof HTMLElement) || !(panelBody instanceof HTMLElement) || !(backdrop instanceof HTMLElement)) {
        return;
      }

      const rows = detailFields
        .filter((field) => data[field.key])
        .map((field) => {
          const value = escapeHtml(data[field.key]);
          return `
            <div style="margin-bottom:22px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:6px">${field.label}</div>
              <div style="font-size:15.5px;line-height:1.65;color:var(--ink)">${value}</div>
            </div>
          `;
        })
        .join('');

      const sourceLink = data.url
        ? `<a href="${data.url}" target="_blank" rel="noopener noreferrer" style="display:inline-block;margin-top:6px;font-weight:700;color:var(--ink);text-decoration:underline">View source document →</a>`
        : '';

      panelBody.innerHTML = `
        <h3 style="font-family:var(--display);font-size:22px;font-weight:700;margin:0 0 24px;padding-right:40px">${escapeHtml(data.item)}</h3>
        ${rows}
        ${sourceLink}
      `;

      backdrop.style.display = 'block';
      panel.style.display = 'block';
      panel.setAttribute('aria-hidden', 'false');
    }

    function closeDetailPanel() {
      if (!(panel instanceof HTMLElement) || !(backdrop instanceof HTMLElement)) {
        return;
      }
      backdrop.style.display = 'none';
      panel.style.display = 'none';
      panel.setAttribute('aria-hidden', 'true');
    }

    closeBtn?.addEventListener('click', closeDetailPanel);
    backdrop?.addEventListener('click', closeDetailPanel);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetailPanel();
    });
  }
</script>
