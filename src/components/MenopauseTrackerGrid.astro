---
import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
} from '../data/menopauseTracker';

type TrackerRow = {
  recordGroup: string;
  jurisdiction: string;
  item: string;
  url?: string;
  focus: string;
  status: string;
  policyAssumption: string;
  governanceBlindSpot: string;
  classification: string;
  legislativeOutcome: string;
};

const standardRows = (
  recordGroup: string,
  rows: typeof FEDERAL | typeof ENACTED | typeof ACTIVE,
): TrackerRow[] =>
  rows.map((row) => ({
    recordGroup,
    jurisdiction: row.jurisdiction,
    item: row.bill,
    url: row.url,
    focus: row.focus,
    status: row.status,
    policyAssumption: row.assumes,
    governanceBlindSpot: row.cannotMeasure,
    classification: row.classification,
    legislativeOutcome: row.notes,
  }));

const didNotPassRows: TrackerRow[] = DID_NOT_PASS.map((row) => ({
  recordGroup: 'Did Not Pass',
  jurisdiction: row.jurisdiction,
  item: row.bill,
  url: row.url,
  focus: row.focus,
  status: row.status,
  policyAssumption: row.assumed,
  governanceBlindSpot: row.failureConfirms,
  classification: 'No Classification',
  legislativeOutcome: row.notes,
}));

const advisoryRows: TrackerRow[] = ADVISORY.map((row) => ({
  recordGroup: 'Advisory',
  jurisdiction: row.jurisdiction,
  item: row.instrument,
  url: row.url,
  focus: row.focus,
  status: row.status,
  policyAssumption: row.structuralRole,
  governanceBlindSpot: '',
  classification: row.classification,
  legislativeOutcome: row.notes,
}));

const rows: TrackerRow[] = [
  ...standardRows('Federal', FEDERAL),
  ...standardRows('Enacted / Passed', ENACTED),
  ...standardRows('Active / In Committee', ACTIVE),
  ...didNotPassRows,
  ...advisoryRows,
];

const gridId = 'menopause-tracker-grid';
const dataId = 'menopause-tracker-data';
---

<div class="tracker-grid-shell">
  <div class="tracker-grid-toolbar">
    <label for="menopause-tracker-search">Search tracker</label>
    <input
      id="menopause-tracker-search"
      type="search"
      placeholder="Search jurisdiction, bill, status, focus, or classification"
      autocomplete="off"
    />
  </div>

  <div
    id={gridId}
    class="tracker-grid"
    aria-label="Menopause legislation tracker"
  ></div>

  <noscript>
    <p class="tracker-grid-notice">
      JavaScript is required to use the interactive legislation tracker.
    </p>
  </noscript>
</div>

<script
  id={dataId}
  type="application/json"
  set:html={JSON.stringify(rows).replace(/</g, '\\u003c')}
></script>

<script>
  import {
    AllCommunityModule,
    ModuleRegistry,
    createGrid,
    themeQuartz,
  } from 'ag-grid-community';

  ModuleRegistry.registerModules([AllCommunityModule]);

  const gridElement = document.getElementById('menopause-tracker-grid');
  const dataElement = document.getElementById('menopause-tracker-data');
  const searchInput = document.getElementById('menopause-tracker-search');

  if (
    gridElement instanceof HTMLDivElement &&
    dataElement instanceof HTMLScriptElement
  ) {
    const rowData = JSON.parse(dataElement.textContent || '[]');

    const rootStyles = getComputedStyle(document.documentElement);
    const readVariable = (name, fallback) =>
      rootStyles.getPropertyValue(name).trim() || fallback;

    const lozenTheme = themeQuartz.withParams({
      fontFamily: readVariable('--sans', 'system-ui, sans-serif'),
      foregroundColor: readVariable('--ink', '#06172f'),
      backgroundColor: readVariable('--paper-2', '#ffffff'),
      headerForegroundColor: '#ffffff',
      headerBackgroundColor: readVariable('--ink', '#06172f'),
      oddRowBackgroundColor: readVariable('--paper', '#DBF3FE'),
      rowHoverColor: readVariable('--paper', '#DBF3FE'),
      borderColor: readVariable('--line', 'rgba(6,23,47,.12)'),
      accentColor: readVariable('--accent', '#e6c84f'),
      selectedRowBackgroundColor: readVariable('--paper', '#DBF3FE'),
      wrapperBorderRadius: '22px',
      headerFontWeight: 700,
      cellHorizontalPadding: 16,
      spacing: 8,
    });

    const linkRenderer = (params) => {
      const value = params.value ?? '';
      const url = params.data?.url;

      if (!url) {
        const span = document.createElement('span');
        span.textContent = value;
        return span;
      }

      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = value;
      link.className = 'tracker-grid-link';
      return link;
    };

    const columnDefs = [
      {
        field: 'recordGroup',
        headerName: 'Record Group',
        minWidth: 170,
        filter: 'agTextColumnFilter',
      },
      {
        field: 'jurisdiction',
        headerName: 'Jurisdiction',
        minWidth: 150,
        filter: 'agTextColumnFilter',
      },
      {
        field: 'item',
        headerName: 'Bill / Instrument',
        minWidth: 210,
        flex: 1,
        cellRenderer: linkRenderer,
      },
      {
        field: 'focus',
        headerName: 'Focus',
        minWidth: 150,
        filter: 'agTextColumnFilter',
      },
      {
        field: 'status',
        headerName: 'Status',
        minWidth: 190,
        filter: 'agTextColumnFilter',
      },
      {
        field: 'policyAssumption',
        headerName: 'Policy Assumption / Structural Role',
        minWidth: 260,
        flex: 1.25,
        wrapText: true,
        autoHeight: true,
      },
      {
        field: 'governanceBlindSpot',
        headerName: 'Governance Blind Spot / Failure Confirms',
        minWidth: 280,
        flex: 1.25,
        wrapText: true,
        autoHeight: true,
      },
      {
        field: 'classification',
        headerName: 'Classification',
        minWidth: 180,
        filter: 'agTextColumnFilter',
      },
      {
        field: 'legislativeOutcome',
        headerName: 'Legislative Outcome',
        minWidth: 300,
        flex: 1.4,
        wrapText: true,
        autoHeight: true,
      },
    ];

    const gridApi = createGrid(gridElement, {
      theme: lozenTheme,
      rowData,
      columnDefs,
      defaultColDef: {
        sortable: true,
        filter: true,
        resizable: true,
        suppressHeaderMenuButton: false,
        wrapHeaderText: true,
        autoHeaderHeight: true,
      },
      pagination: true,
      paginationPageSize: 20,
      paginationPageSizeSelector: [10, 20, 50],
      animateRows: false,
      ensureDomOrder: true,
      suppressCellFocus: true,
      rowHeight: 54,
      headerHeight: 58,
      getRowId: (params) =>
        [
          params.data.recordGroup,
          params.data.jurisdiction,
          params.data.item,
        ].join('::'),
    });

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', () => {
        gridApi.setGridOption('quickFilterText', searchInput.value);
      });
    }
  }
</script>

<style>
  .tracker-grid-shell {
    width: 100%;
  }

  .tracker-grid-toolbar {
    display: grid;
    gap: 8px;
    max-width: 720px;
    margin-bottom: 22px;
  }

  .tracker-grid-toolbar label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .tracker-grid-toolbar input {
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    font: inherit;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .tracker-grid-toolbar input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(230, 200, 79, 0.22);
  }

  .tracker-grid {
    width: 100%;
    height: 760px;
    min-height: 560px;
  }

  .tracker-grid-notice {
    margin-top: 18px;
    color: var(--muted);
  }

  :global(.tracker-grid-link) {
    color: var(--brand);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .tracker-grid {
      height: 680px;
    }
  }
</style>
