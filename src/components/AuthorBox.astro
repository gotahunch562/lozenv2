---
import FounderPortrait from './FounderPortrait.astro';

interface Props {
  bio?: string;
}

const {
  bio = 'Akilah has spent two decades helping businesses make better decisions.',
} = Astro.props;
---

<div class="author-box reveal">
  <FounderPortrait variant="author" alt="Akilah E. Kamaria" />
  <div>
    <div class="nm">Akilah E. Kamaria </div>
    <div class="rl">Founder &amp; Lead Consultant, Lozen Advisory LLC</div>
    <p>{bio}</p>
  </div>
</div>
