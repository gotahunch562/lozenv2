---
interface Props {
  serviceHighlight: string;
  selectedService: string;
}

const { serviceHighlight, selectedService } = Astro.props;

const services = [
  'Global Buyer Sourcing',
  'Market Research & Entry',
  'Licensing & Documentation',
  'Shipping & Logistics',
  'Payments & LC',
  'General consultation',
];
---

<section id="consult" class="cta-sec">
  <div class="wrap cta-wrap">
    <div>
      <span class="eyebrow">Get started</span>
      <h2 class="h2">Book your free consultation</h2>
      <p class="lead" set:html={`Talk to a trade expert about <strong>${serviceHighlight}</strong> for your business. No cost, no obligation — just a clear next step toward exporting profitably.`} />
      <div class="contact-list">
        <a href="tel:+10000000000"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg></span> +1 (000) 000-0000</a>
        <a href="mailto:hello@example.com"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span> hello@example.com</a>
        <a href="#"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span> 123 Trade Avenue, Your City</a>
      </div>
    </div>
    <div>
      <form class="form" id="consultForm">
        <h3>Request a Consultation</h3>
        <p class="sub">Fill in your details — we'll reach out within 24 hours.</p>
        <div class="row2">
          <div class="field"><label>Your name</label><input type="text" required placeholder="Full name" /></div>
          <div class="field"><label>Phone</label><input type="tel" placeholder="Phone number" /></div>
        </div>
        <div class="row2">
          <div class="field"><label>Email</label><input type="email" required placeholder="you@email.com" /></div>
          <div class="field"><label>Company</label><input type="text" placeholder="Company name" /></div>
        </div>
        <div class="field">
          <label>Interested in</label>
          <select>
            {services.map((service) => (
              <option selected={service === selectedService}>{service}</option>
            ))}
          </select>
        </div>
        <div class="field"><label>Message</label><textarea rows="3" placeholder="Tell us about your product and goals"></textarea></div>
        <button type="submit" class="btn btn-primary">Submit Request →</button>
      </form>
      <div class="form-success" id="consultSuccess">
        <div class="big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:52px;height:52px;color:var(--accent)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
        <h3>Thank you!</h3>
        <p>Your request has been received. A trade expert will reach out within 24 hours.</p>
      </div>
    </div>
  </div>
</section>
