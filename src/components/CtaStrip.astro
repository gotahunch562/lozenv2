---
interface Props {
  title: string;
  description: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  paddedTop?: boolean;
}

const {
  title,
  description,
  primaryHref = '/contact',
  primaryLabel = 'Get a Free Consultation →',
  secondaryHref = '/webinar',
  secondaryLabel = 'Join the free webinar',
  paddedTop = false,
} = Astro.props;
---

<section style={paddedTop ? 'padding-top:0' : undefined}>
  <div class="wrap">
    <div class="cta-strip reveal">
      <h2>{title}</h2>
      <p>{description}</p>
      <div class="row">
        <a href={primaryHref} class="btn btn-light">{primaryLabel}</a>
        <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
